    <script>

        var clickCount = 0;
        var gHammer =
            $('#target').hammer({
                pie: true,
                pies: {
                    DomPie: '#DomPie',
                    DataPie: {
                        cssBackground: {
                            width: 400,
                            height: 400,
                            marginLeft: -200,
                            marginTop: -200,
                            backgroundImage: 'url(PieBackground_Pan.png)'
                        },
                        rotateItems: false,
                        slices: [
                            {
                                direction: 0,
                                items: [
                                    {
                                        label: '<center>0<br/>degrees</center>',
                                        pieitemselect: function(event) { console.log("DataPie item 0"); },
                                        nextPie: 'DomPie',
                                        itemRotation: 45
                                    },
                                ]
                            },
                            {
                                direction: 90,
                                items: [
                                    {
                                        label: '<center>90<br/>degrees</center>',
                                        pieitemselect: function(event) { console.log("DataPie item 90"); },
                                        nextPie: 'DomPie'
                                    },
                                ]
                            },
                            {
                                direction: 180,
                                items: [
                                    {
                                        label: '<center>180<br/>degrees</center>',
                                        pieitemselect: function(event) { console.log("DataPie item 180"); },
                                        nextPie: 'DomPie',
                                        itemRotation: -45
                                    },
                                ]
                            },
                            {
                                direction: 270,
                                items: [
                                    {
                                        label: '<center>270<br/>degrees</center>',
                                        pieitemselect: function(event) { console.log("DataPie item 270"); },
                                        nextPie: 'DomPie'
                                    },
                                ]
                            }
                        ]
                    }
                },
                defaultPie: 'DomPie',
                trackPieItemSelect: function(event, hammer, pie, slice, item) {
                    console.log("options trackPieItemSelect", "event", [event], "hammer", [hammer], "pie", [pie], "slice", [slice], "item", [item]);
                }
            })
            .on('piedown', function(event, pie) {
              console.log("on piedown", "event", event, "pie", pie);
            })
            .on('pieup', function(event, pie) {
              console.log("on pieup", "event", event, "pie", pie);
            })
            .on('piestart', function(event, pie) {
              console.log("on piestart", "event", event, "pie", pie);
            })
            .on('pieend', function(event, pie) {
              console.log("on pieend", "event", event, "pie", pie);
            })
            .on('piepin', function(event, pie) {
              console.log("on piepin", "event", event, "pie", pie);
            })
            .on('piecancel', function(event, pie) {
              console.log("on piecancel", "event", event, "pie", pie);
            })
            .on('piechange', function(event, pie) {
              console.log("on piechange", "event", event, "pie", pie);
            })
            .on('pieupdate', function(event, pie) {
              console.log("on pieupdate", "event", event, "pie", pie);
            })
            .on('pieselect', function(event, pie) {
              console.log("on pieselect", "event", event, "pie", pie);
            })
            .on('pieslicechange', function(event, pie, pieslice) {
              console.log("on pieslicechange", "event", event, "pie", pie, "pieslice", pieslice);
            })
            .on('piesliceupdate', function(event, pie, pieslice) {
              console.log("on piesliceupdate", "event", event, "pie", pie, "pieslice", pieslice);
            })
            .on('piesliceselect', function(event, pie, pieslice) {
              console.log("on piesliceselect", "event", event, "pie", pie, "pieslice", pieslice);
            })
            .on('pieitemchange', function(event, pie, pieslice, pieitem) {
              console.log("on pieitemchange", "event", event, "pie", pie, "pieslice", pieslice, "pieitem", pieitem);
            })
            .on('pieitemupdate', function(event, pie, pieslice, pieitem) {
              console.log("on pieitemupdate", "event", event, "pie", pie, "pieslice", pieslice, "pieitem", pieitem);
            })
            .on('pieitemselect', function(event, pie, pieslice, pieitem) {
              console.log("on pieitemselect", "event", event, "pie", pie, "pieslice", pieslice, "pieitem", pieitem);
            });

        console.log("gHammer", gHammer);

