/EmacsOptionMenu [
  (Session)		{}
  (Ruler)		{}
  (Minor Mode)		{}
  (Help)		{}
  (Mouse)		{}
  (Environment)		{}
  (Variable)		{}
  (Macro)		{}
  (Description Search)	{}
  (Word Description)	{}
  (Any Option)		{}
] /new EmacsDefaultPopupMenu send def

/EmacsMacroMenu [
  (Playback)		{}
  (Start)		{}
  (Stop)		{}
  (Edit)		{}
] /new EmacsDefaultPopupMenu send def

/EmacsSystemMenu [
  (Shell)		{}
  (PS Shell)		{}
