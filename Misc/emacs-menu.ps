  (text-mode)		{}
  (elec-mlisp-mode)	{}
  (elec-c-mode)		{}
  (elec-lisp-mode)	{}
  (nroff-mode)		{}
  (forth-mode)		{}
] def

/EmacsBufferMenu [
  (Switch)		{}
  (Describe)		{}
  (Rename)		{}
  (Edit Name)		{}
  (Delete)		{}
  (Major Mode)		EmacsMajorModeMenu
  (Minor Mode)		{}
  (Edit List)		{}
] /new EmacsDefaultPopupMenu send def

/EmacsFileMenu [
  (Describe File)	{}
  (Save)		{}
  (Switch)		{}
  (Delete)		{}
  (Rename)		{}
  (Edit Name)		{}
