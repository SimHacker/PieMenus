] /new EmacsDefaultPopupMenu send def

/EmacsCommandMenu [
  (System...)		EmacsSystemMenu
  (Exit Emacs)		{}
] /new EmacsDefaultPopupMenu send def


/EmacsEditMenu [
  (Move...)		EmacsMoveMenu
  (Macro...)		EmacsMacroMenu
  (Option...)		EmacsOptionMenu
] /new EmacsDefaultPopupMenu send def

/EmacsHelpMenu [
  (Apropos)		{}
  (Function)		{}
  (Variable)		{}
  (Key)			{}
  (Where Is)		{}
  (Bindings)		{}
  (Last Keystrokes)	{}
  (Buffer)		{}
  (Major Mode)		{}
  (Recursive Edit)	{}
  (Emacs News)		{}
  (Info)		{}
  (Tutorial)		{}
] /new EmacsDefaultPopupMenu send def

/EmacsMenu [
  (Edit...)		EmacsEditMenu
  (Window...)		EmacsWindowMenu
  (Buffer...)		EmacsBufferMenu
  (File...)		EmacsFileMenu
  (Mode...)		/getThisWindowModeMenu cvx
  (Command...)		EmacsCommandMenu
  (Help...)		EmacsHelpMenu
  (Style...)		EmacsStyleMenu
] /new EmacsDefaultPopupMenu send def

end % EmacsDict
