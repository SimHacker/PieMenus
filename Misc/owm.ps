%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Open Window Manager

/NeWS 3 0 findpackage beginpackage
/TNTCore 3 0 findpackage beginpackage
/TNT 3 0 findpackage beginpackage
/X11 3 0 findpackage beginpackage
/debug 1 1 findpackage beginpackage

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Flags

/Debug false def

%/UseTabs? true def
/UseTabs? false def

UseTabs? /TNT 3 0 findpackage /ClassTabBaseWindow known and {
    /FavoritePopupWindow {ClassTabPopupWindow} def
    /FavoriteBaseWindow {ClassTabBaseWindow} def

    ClassTabBaseWindow ClassTabPopupWindow
} {
    /FavoritePopupWindow {ClassPopupWindow} def
    /FavoriteBaseWindow {ClassBaseWindow} def
} ifelse

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% ClassXClientCanvas

/GetProp { % canvas property => value true
	   %		     => false
    2 copy xcheckproperty {
	2 copy xlengthofproperty string
	0 exch xgetproperty
	pop pop pop pop true
    } { pop pop false } ifelse
} def

/ClassXClientCanvas {
    /ClassXClientCanvas ClassXCanvas [/Protocols]
    classbegin
	
	
	/NewObject { % can => can
	    /NewMagic self send
	} def
	
	/GetProp /GetProp load def
	
	% Send an event of type ClientMessage to this window.  If the array is
	% given, fills in the data fields of the event with those numbers.  If
	% the array is not given, zeroes are filled in.  REMIND: this routine
	% should probably put a timestamp into one of the data fields.
	%
	/SendClientMessage { % atomname [ x x x x x ] => -
	    % atomname		  => -
	    dup type /arraytype ne { 
		ZeroArray 
	    } if
	    
	    32 string 3			% 3 is starting index into string
	    3 -1 roll			% atom str 3 [.....]
	    {				% atom str i xi
		3 copy putcard32
		pop 1 add
	    } forall pop			% atom str
	    
	    % The first byte of the message is the event code, and the second
	    % byte is the format code.  The third and fourth bytes are the
	    % sequence field.  REMIND: this relies on writeXevent to fill
	    % it in properly.
	    
	    dup 0 0 putcard32		% clear the first word
	    dup 0 33 put			% RequestCode=33 (ClientMessage)
	    dup 1 32 put			% Format=32
	    
	    % Put the client ID in the word #1 and the atom in word #2.
	    
	    dup 1 XID putcard32		% atom str
	    
	    dup 3 -1 roll			% str str /atom
	    false XInternAtom
	    2 exch putcard32		% str
	    
	    createevent begin
		/Canvas self def
		/Name /ClientMessage def
		/Action exch def		%
		/ClientData 0 def
		/TimeStamp lasteventtime def
		currentdict sendevent
	    end
	} def
	
	% Sends a WM_PROTOCOLS style ClientMessage.
	%
	/SendProtocols { % atom => -
	    false XInternAtom
	    /WM_PROTOCOLS
	    [ 3 -1 roll lasteventtime servertoxtime 0 0 0 ]
	    /SendClientMessage self send
	} def
	
	/SendConfigure { % - => -
	    createevent dup begin
		/Name /ConfigureNotify def
		/Canvas self def
		/Action 10 dict dup begin
		    gsave
		    /Window XID def
		    /Sibling 0 def
		    /Mask 0 def
		    /framebufferof self send setcanvas
		    /size self send /Height exch cvi def /Width exch cvi def
		    /location self send
		    /Y exch cvi def
		    /X exch cvi def
		    /Border 0 def
		    grestore
		end def
		/TimeStamp lasteventtime def
	    end sendevent
	} def
	
	/UpdateProtocols { % - => -
	    /Protocols dictbegin
		self /WM_PROTOCOLS xcheckproperty {
		    /value
		    self /WM_PROTOCOLS
		    2 copy xlengthofproperty string
		    0 exch xgetproperty pop pop pop pop
		    def
		    0 1 value length 4 idiv 1 sub {
			value exch getcard32 XGetAtomName dup def
		    } for
		} if
	    dictend promote
	} def
	
	/SetKeyboardFocus { % timestamp restore? => accepted?
	    /ICCCMKeyable? self send {
		/SetKeyboardFocus super send
	    } { 
		pop pop false
	    } ifelse
	    /TakeFocus self send
	} def
	
	/TakeFocus { % - => -
	    Protocols null ne {
		Protocols /WM_TAKE_FOCUS known {
		    /WM_TAKE_FOCUS /SendProtocols self send
		} if
	    } if
	} def
	
	/Keyable? true def
	
	/ICCCMKeyable? { % - => bool
	    self /WM_HINTS GetProp {
		dup 0 getcard32 1 and 0 ne {
		    1 getcard32 0 ne
		} {
		    pop true
		} ifelse
	    } {
		true
	    } ifelse
	} def
	
	/KeyStart { % event => 
	    self /WM_COLORMAP_WINDOWS GetProp {
		1 dict begin
		    /value exch def
		    0 1 value length 4 idiv 1 sub {
			value exch getcard32 xlookupid {
			    /Colormap get dup null ne {
				installcolormap
			    } {
				pop 
			    } ifelse
			} if
		    } for
		end
	    } {
		Colormap dup null ne {
		    installcolormap
		} {
		    pop 
		} ifelse
	    } ifelse
	    /KeyStart super send
	} def
	
	/Helpable? true def
	
	/HandleHelp { redistributeevent } def
	
	/Paint nullproc def
	
	/preferredsize { % - => w h
	    self /WM_NORMAL_HINTS GetProp {
		1 dict begin
		    /value exch def
		    value 0 getcard32 8 and 0 ne {
			value 3 getcard32 2 add value 4 getcard32 2 add
			dup 32000 gt 1 index 0 lt or 
			2 index 32000 gt or 2 index 0 lt or {
			    pop pop /size self send
			} if
		    } { 
			/size self send 
		    } ifelse
		end
	    } {
		/size self send
	    } ifelse
	} def 
	
	/minsize { % - => w h
	    self /WM_NORMAL_HINTS GetProp {
		1 dict begin
		    /value exch def
		    value 0 getcard32 16 and 0 ne {
			value 5 getcard32 2 add value 6 getcard32 2 add
			dup 32000 gt 1 index 0 lt or 
			2 index 32000 gt or 2 index 0 lt or {
			    pop pop /minsize self send
			} if
		    } { 
			/minsize super send
		    } ifelse
		end
	    } {
		/minsize super send
	    } ifelse
	} def
	
	/map { % - => -
	    createevent dup begin
		/Name /MapNotify def
		/Canvas self def
		/Action self def
		/TimeStamp lasteventtime def
	    end sendevent
	    /map super send
	} def
	
	/reshape { % x y w h => -
	    self /WM_NORMAL_HINTS GetProp {
		5 dict begin
		    /value exch def
		    value 0 getcard32 1 6 bitshift and 0 ne {
			/minsize self send /mh exch def /mw exch def
			/width_inc value 9 getcard32 def
			/height_inc value 10 getcard32 def
			mh sub height_inc div floor height_inc mul mh add 1 add exch
			mw sub width_inc div floor width_inc mul mw add 1 add exch
		    } if
		end
	    } if
	    /reshape super send
	    pause
	    /SendConfigure self send
	} def
	
	/HandleDamage { % event => -
	    redistributeevent
	} def 
	
	/activate { % emgr => -
	    EventMgr null eq {                  % REMIND: is this necessary?
		/EventMgr exch def 
		self                                    % self
		Frontable? {
		    dup /addclient FrontService send
		} if
		Helpable? {
		    dup /addclient HelpService send
		} if
		Keyable? {
		    dup /addclient KeyService send
		} if
		Menuable? {
		    dup /addclient MenuService send
		} if
		Openable? {
		    dup /addclient OpenService send
		} if
		Receptible? {
		    dup /addclient ReceptionService send
		} if
		Selectable? {
		    dup /addclient ClassSelectUI send
		} if
		Trackable? {
		    dup /addclient TrackService send
		} if
		Transparent not {
		    dup /addclient DamageService send
		} if
		pop % the self
	    } {
		pop
	    } ifelse
	} def 
	
	/KillClient { % - => -
	    Protocols /WM_DELETE_WINDOW known {
		/WM_DELETE_WINDOW /SendProtocols self send
	    } {
		XID xkillclient
	    } ifelse
	} def
	
	/GetGroupID { % can => id
	    1 dict 
	    begin
		/group null def
		
		self /WM_HINTS GetProp {
		    dup 0 getcard32 64 and 0 ne {
			8 getcard32 /group exch def
		    } {
			pop
		    } ifelse
		} if
		
		self /WM_TRANSIENT_FOR GetProp {
		    0 getcard32 /group exch def
		} if
		
		group null eq {
		    self /XID get
		} {
		    group 0 eq {
			self /XID get
		    } {
			group
		    } ifelse
		} ifelse
	    end
	} def
	
	/GetGroup { % can => frame
	    GetGroupID 
	    Windows 1 index known {
		Windows exch get
	    } { 
		pop null
	    } ifelse
	} def
	
	/GroupActivate { %
	    Windows self /XID get known {
		3 dict begin
		    /frame Windows self /XID get get def
		    /group /GetGroup self send def
		    
		    frame /SuperWindow known {
			frame /removesubwindow frame /SuperWindow get send
		    } if
		    /deactivate frame send
		    
		    group null eq group frame eq or {
			EventManager /activate frame send
		    } {
			frame soften /addsubwindow group send
		    } ifelse
		end
	    } if
	} def
	
    classend store % ClassXClientCanvas
    ClassXClientCanvas
} def

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% ClassX11ManagerMixin

/ClassX11ManagerMixin {
    
    /ClassX11ManagerMixin ClassWindow
    [/WidthInc /HeightInc /FirstMapping]
    classbegin
	/update_sticky { % - => -
	    /Center /client self send {
		/WM_CLASS GetProp {
		    self /Stuck undef
		    (\0) search pop 3 1 roll pop pop
		    AutoSticky {
			1 index eq {
			    self /Stuck true put
			    exit
			} if
		    } forall
		    pop
		} if
	    } if
	} def

	/GetProp /GetProp load def
	
	/NewInit { % client => -
	    /NewInit super send
	    self /WM_STATE xdeleteproperty % The frame is not a ICCCM window
	} def
	
	/SetFirstMapping { % bool => -
	    /FirstMapping exch def
	} def
	
	/open { % - => -
	    /open super send
	    /Center /client self send {
		/map exch send
	    } if
	} def
	
	/place { % - => -
	    /Center /client self send {
		/WM_NORMAL_HINTS GetProp {
		    5 dict 
		    begin
			/value exch def
			value 0 getcard32 1 and 0 ne 
			value 0 getcard32 4 and 0 ne or {
			    gsave Parent setcanvas
			    [ 
				1 0 0 -1 0 Parent false getbbox 
				4 1 roll pop pop pop 
			    ] setmatrix  
			    
			    value 1 getcard32 
			    value 2 getcard32 
			    
			    dup 32000 gt 1 index 0 lt or 
			    2 index 32000 gt or 2 index 0 lt or {
				pop pop grestore /place super send
			    } {
				/y exch def
				/x exch def
				
				/preferredsize self send /h exch def 
				/w exch def
				/y /size /framebufferof self send send exch 
				pop y sub h sub 
				/Label? self send {
				    {
					HeaderHeight HeaderGap add FooterGap 
					add
				    } 
				    self send sub 
				} if
				def
				
				x y w h /reshape self send
				
				grestore
			    } ifelse
			} {
			    /place super send
			} ifelse
		    end
		} {
		    /place super send
		} ifelse
	    } {
		/place super send
	    } ifelse 
	} def
	
	/GetIconWindow { % can => can true
	    %     => false
	    /WM_HINTS GetProp {
		2 dict begin
		    /value exch def
		    /flags value 0 getcard32 def
		    flags 4 and 0 ne {
			value 3 getcard32 xlookupid
		    } {
			flags 8 and 0 ne {
			    value 4 getcard32 xlookupid
			} {
			    false
			} ifelse
		    } ifelse
		end
	    } {
		false
	    } ifelse
	} def
	
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
	% ClassXGenericCanvas
	
	/ClassXGenericCanvas ClassXCanvas []
	classbegin
	    /NewObject { % can => can
		/NewMagic self send
	    } def
	    
	    /Paint nullproc def
	    
	    /size {
		/size super send
		4 4 xyadd
	    } def
	    
	classend def % ClassXGenericCanvas
	
	/IconClientXY	{2 2} def
	
	/map { % - => -
	    /Center /client self send {
		dup GetIconWindow {
		    dup /Parent get null ne {
			/new ClassXGenericCanvas send
			dup begin
			    /Matrix [ 
				1 0 0 -1 0
				currentdict false getbbox 
				4 1 roll pop pop pop 
			    ] def
			end
			/PaintIcon {
			    /PaintIconBackground self send
			    Selected? {PaintBorder} if
			} promote
		    } {
			3 dict begin
			    /ic exch def
			    {
				/foo exch /size eq {
				    false getbbox 4 2 roll pop pop
				} {
				    imagecanvas
				} ifelse
			    } dup length array copy cvx
			    dup 0 ic put
			end
		    } ifelse
		    /seticonimage self send
		} if
		/_OL_WIN_ATTR GetProp {
		    dup length 12 eq {
			2 getcard32 XGetAtomName /_OL_PIN_OUT eq {
			    /Pinned? false def
			} {
			    /Pinned? true def
			} ifelse
		    } {
			dup 0 getcard32 4 and 0 ne {
			    3 getcard32 1 eq {
				/Pinned? true def
			    } {
				/Pinned? false def
			    } ifelse
			} {
			    pop
			} ifelse
		    } ifelse
		} {
		    /Pinned? true def
		} ifelse
	    } if
	    /map super send
	} def
	
	/DoMap { % can => -
	    FirstMapping {
		false /SetFirstMapping self send
		
		/WM_HINTS GetProp {
		    3 dict begin
			/value exch def
			
			value 0 getcard32 16 and 0 ne {
			    self /IconXY [
				value 5 getcard32 
				/size /framebufferof self send send exch pop
				value 6 getcard32 sub 64 sub
			    ] cvx put
			} if
			
			value 0 getcard32 2 and 0 ne {
			    value 2 getcard32 1 eq {
				/open self send
			    } {
				/close self send
			    } ifelse
			} {
			    /open self send
			} ifelse
		    end
		} { 
		    /open self send
		} ifelse
	    } {
		/open self send
	    } ifelse
	    /map self send
	    /totop self send
	} def
	
	/DoConfig { % frame canvas => -

	    10 dict begin
		gsave
		/can exch def
		/frame exch def
		/framebufferof frame send setcanvas
		
		can /config_width known 
		can /config_height known or
		can /config_x known or 
		can /config_y known or {
		    
		    /w can /config_width known 
		    { 
			/config_width can send 
			/minsize can send pop max
		    } {
			/size can send pop 
		    } ifelse 
		    def
		    
		    /h can /config_height known 
		    { 
			/config_height can send 
			/minsize can send exch pop max
		    } {
			/size can send exch pop 
		    } ifelse 
		    def
		    
		    /preferredsize [ w h ] cvx /installmethod can send
		    /preferredsize frame send 
		    /h exch def
		    /w exch def
		    
		    /x can /config_x known {
			/config_x can send
		    } {
			/location frame send pop
		    } ifelse 
		    def
		    
		    /y can /config_y known {
			/size /framebufferof can send send exch pop 
			/config_y can send sub h sub
		    } {
			/location frame send exch pop
			can /config_height known {
			    /size can send exch pop /config_height can 
			    send sub add
			} if
		    } ifelse 
		    def

%		    /foo dbgbreakpoint		    

		    x y /preferredsize frame send /reshape frame send
		    can /config_x undef
		    can /config_y undef
		    can /config_width undef
		    can /config_height undef
		} if
		grestore
	    end
	} def
	
	/destroy {
	    ClientDict { % Reparent them back to the framebuffer!
		/framebufferof self send /reparent 3 -1 roll send pop
	    } forall
	    
	    /Center /client self send { % Map the center one
		dup /XID get xlookupid {
		    pop /map exch send
		} {
		    pop
		} ifelse
	    } if
	    
	    /WMInterests where {
		pop
		WMInterests /Canvas get self undef
	    } if
	    /destroy super send
	} def
	
    classend store % ClassX11ManagerMixin
    ClassX11ManagerMixin
} def

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% ClassX11BaseWindow

/ClassX11BaseWindow {
    /ClassX11BaseWindow [ ClassX11ManagerMixin FavoriteBaseWindow ] []
    classbegin
	/Footer? false def
	
	/QuitFromUser { % ctl => -
	    pop /KillClient /Center /client self send pop send
	} def
    classend store % ClassX11BaseWindow
    ClassX11BaseWindow
} def

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% ClassX11PopupWindow

/ClassX11PopupWindow {
    /ClassX11PopupWindow [ ClassX11ManagerMixin FavoritePopupWindow ] []
    classbegin
	/Footer? false def
	
	/unpin { % - => -
	    /Center /client self send {
		1 dict 
		begin
		    /can exch def
		    can /_OL_PIN_STATE 4 string dup 0 0 putcard32 
		    /INTEGER false XInternAtom 32 xsetproperty
		    /Protocols can send /WM_DELETE_WINDOW known {
			/Pinned? false store
			/KillClient can send
		    } {
			/unpin super send
		    } ifelse
		end
	    } { 
		/unpin super send 
	    } ifelse
	} def
	
	/pin { % - => -
	    /pin super send
	    /Center /client self send {
		/_OL_PIN_STATE 4 string dup 0 1 putcard32 
		/INTEGER false XInternAtom 32 xsetproperty
	    } if
	} def
	
	/seticonlabel { % label => -
	    pop 
	} def
	
	/seticonimage { % image => -
	    pop 
	} def
	
	/QuitFromUser { % ctl => -
	    pop /KillClient /Center /client self send pop send
	} def
	
	/DismissFromUser { % ctl => -
	    pop /KillClient /Center /client self send pop send
	} def
	
	/DismissAllFromUser { % ctl => -
	    pop /KillClient /Center /client self send pop send
	} def
	
	/HandleOpen { % event => -
	    pop /unpin self send
	} def
	
    classend store % ClassX11PopupWindow
    ClassX11PopupWindow
} def

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% ClassX11HelpWindow

/ClassX11HelpWindow {
    /ClassX11HelpWindow ClassX11PopupWindow []
    classbegin
	/Reshape? false def
    classend store % ClassX11HelpWindow
    ClassX11HelpWindow
} def

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% ClassX11NoticeWindow

/ClassX11NoticeWindow {
    /ClassX11NoticeWindow [ClassX11ManagerMixin ClassBaseWindow] []
    classbegin
	/Close? false def
	/Footer? false def
	/Label? false def
	/Pin? false def
	/Reshape? false def
	/Pinned? false def
	/Menuable? false def
	
	/QuitFromUser { % ctl => -
	    pop /KillClient /Center /client self send pop send
	} def
    classend store % ClassX11NoticeWindow
    ClassX11NoticeWindow
} def

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Utilities

/GetFrameClass { % can => frame
    1 dict begin
	/can exch def
	% Now, we need to wrap a canvas around it.
	can /_OL_WIN_ATTR GetProp {
	    dup length 12 eq {
		0 getcard32 XGetAtomName
	    } {
		1 getcard32 XGetAtomName
	    } ifelse
	} {
	    /GetGroupID can send can /XID get eq {
		/_OL_WT_BASE
	    } {
		/_OL_WT_CMD
	    } ifelse
	} ifelse

	{
	    /_OL_WT_BASE {
		ClassX11BaseWindow
	    }
	    /_OL_WT_CMD {
		ClassX11PopupWindow
	    }
	    /_OL_WT_NOTICE {
		ClassX11NoticeWindow
	    }
	    /_OL_WT_HELP {
		ClassX11HelpWindow
	    }
	    /Default
	    /_OL_WT_OTHER {
		ClassX11BaseWindow
	    }
	} case
    end
} def

/UpdateDecor { % frame can => -
    3 dict begin
	/can exch def
	/win exch def
	can /_OL_DECOR_ADD GetProp {
	    /val exch def
	    0 1 val length 4 idiv 1 sub {
		val exch getcard32 XGetAtomName {
		    /_OL_DECOR_CLOSE { 
			/Close? true /setattribute win send
		    }
		    /_OL_DECOR_RESIZE {
			/Reshape? true /setattribute win send
		    }
		    /_OL_DECOR_HEADER {
			/Label? true /setattribute win send
		    }
		    /_OL_DECOR_PIN {
			/Pin? true /setattribute win send
		    }
		} case
	    } for
	} if
	can /_OL_DECOR_DEL GetProp {
	    /val exch def
	    0 1 val length 4 idiv 1 sub {
		val exch getcard32 XGetAtomName {
		    /_OL_DECOR_CLOSE { 
			/Close? false /setattribute win send
		    }
		    /_OL_DECOR_RESIZE {
			/Reshape? false /setattribute win send
		    }
		    /_OL_DECOR_HEADER {
			/Label? false /setattribute win send
		    }
		    /_OL_DECOR_PIN {
			/Pin? false /setattribute win send
		    }
		} case
	    } for
	} if
    end
} def

/GetPinstate {
    /_OL_WIN_ATTR GetProp {
	dup length 12 eq {
	    2 getcard32 XGetAtomName /_OL_PIN_IN eq true
	} {
	    dup 0 getcard32 4 and 0 ne {
		3 getcard32 1 eq true
	    } {
		pop false
	    } ifelse
	} ifelse
    } {
	false
    } ifelse
} def

/BuildWindow {
    10 dict begin
	gsave
	    /xid exch def

	    % First, we need to transform the canvas.
%	    dup isinstance? not {
		/new ClassXClientCanvas send
%	    } if

	    /can exch def

	    % Now, we need to wrap a canvas around it.
	    can GetFrameClass
	    can
	    /framebufferof can send
	    /FindVRoom where { pop FindVRoom } if
	    /new 4 -1 roll send 
	    /b exch def

	    % decorate it
	    b can UpdateDecor

	    can GetPinstate {
		0 ne b /Pinned? 3 -1 roll put
	    } if

	    % Name it
	    can /WM_NAME GetProp {
		/setlabel b send
	    } if

	    can /WM_ICON_NAME GetProp {
		/seticonlabel b send
	    } if

	    /UpdateProtocols can send

	    % Say it is a window!
	    can /WM_STATE 8 string 
	    dup 0 1 putcard32
	    dup 1 b /XID get putcard32
	    /INTEGER false XInternAtom 32 xsetproperty

	    % Now, we need to place it
	    /place b send

	    % Config it
	    b can /DoConfig b send

	    /layout b send % remove this later!

	    % Save a reference
	    Windows xid b put

	    % Now, activate it
	    /GroupActivate can send

	    true /SetFirstMapping b send

	    b /SubstructureRedirect EventManager put

	    WMInterests /Canvas get b soften dup put
	grestore
    end
} def

/WrapAllWindows {
    1 dict begin
	FrameBuffers {
	    /fr exch def
	    [ 
		fr /TopChild get
		{
		    dup /CanvasBelow get dup null eq {
			pop exit
		    } if
		} loop
	    ]
	    {
		begin
		    Mapped OverrideRedirect not and {

			fr setcanvas

                        pause pause pause
			currentdict /new ClassXClientCanvas send pop
                        /preferredsize [/size currentdict send] cvx 
                        /installmethod currentdict send

			/location currentdict send           % X_loc Y_loc
			/size currentdict send exch pop add  % X Y'

			currentdict XID BuildWindow 
			/size Windows XID get send exch pop sub 
			/preferredsize Windows XID get send /reshape Windows XID get send
			/map currentdict send
			currentdict /DoMap Windows XID get send
		    } if
		end
	    } forall 
	} forall
    end
} def

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Root menu interface

/Menu_Out currentprocess /Stdout get def

/DamageCanvasTree { % can => -
    gsave
      setcanvas clippath extenddamageall
    grestore
} def

/REFRESH { % - => -
    FrameBuffers {
	DamageCanvasTree
    } forall
} def

/SPAWN { % menu str => - 
    3 dict begin
	/framebufferof 3 -1 roll send /fb exch def

	spawn_tag Menu_Out tagprint
	Menu_Out typedprint

	FrameBuffers fb arrayindex not { 0 } if
	Menu_Out typedprint
	fb /_SUN_SUNVIEW_ENV GetProp not { nullstring } if
	Menu_Out typedprint

	Menu_Out flushfile
    end
} def

/PROPERTIES { % menu => -
    ($OPENWINHOME/bin/props) SPAWN
} def

/POSTSCRIPT { % str => -
  { newprocessgroup framebuffer setcanvas cvx exec } fork /ProcessName (OWM Menu PostScript) put pop
} def

/SAVE_WORKSPACE { % menu => -
  ($OPENWINHOME/bin/owplaces -script -multi -ampersand -output $HOME/.openwin-init)
  SPAWN
} def

/RESTART { % - => -
} def

/EXIT_NO_CONFIRM { % - => -
    shutdownserver
} def

/EXIT { % - => -
    gsave
    null canvasesunderpoint dup length 2 sub get setcanvas

    userdict /notice null currentcanvas /new ClassNotice send put

    /new ClassEventMgr send /activate notice send
    (Please confirm exit from window system) /settext notice send

    /noticebuttons /Spaced currentcanvas /new ClassButtons send def
    [(Exit) (Cancel)]
    /setitemlist noticebuttons send
    1 /setdefault noticebuttons send
    { 
	pop 0 eq {
	    shutdownserver
	} {
	    /close notice send
	    userdict /notice undef
	} ifelse
    } /setnotifier noticebuttons send
    10 0 /setgaps noticebuttons send

    noticebuttons /setbuttons notice send
    null /open notice send
    grestore
} def

/OPEN_CLOSE_SELN {
    /SelectedWindows ClassWindow send {
	/toggleopened exch send pop
    } forall
} def

/FULL_RESTORE_SIZE_SELN {
    /SelectedWindows ClassWindow send {
	/togglezoomed exch send pop
    } forall
} def

/BACK_SELN {
    /SelectedWindows ClassWindow send {
	/tobottom exch send pop
    } forall
} def

/QUIT_SELN {
    /SelectedWindows ClassWindow send {
	null /QuitFromUser 3 -1 roll send pop
    } forall
} def

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% CPS interface

/SetRootMenu { % menuproc => -
    FrameBuffers {
	setcanvas dup exec
	/setmenu currentcanvas send
	true /setmenuable currentcanvas send
    } forall pop
} def

/MakeMenu { % - => menu
    /Calculated currentcanvas /new ClassMenu send
} def

/separated false def

/menu_layout { % pos => layout
    0 eq {
	[/NorthWest {/NorthWest PARENT POSITION }]
    } {
	[/NorthWest {/SouthWest PREVIOUS POSITION }]
    } ifelse

    separated {
	dup dup 1 get {0 10 xysub} append cvx 1 exch put
	/separated false store
    } if
} def

%/menu_layout { pop } def

/InitMenu { % menu [itemlist] title => menu
    /setlabel 3 index send		% menu [itemlist]
    /setitemlist 2 index send		% menu
    userdict /settarget 2 index send	% menu
} def

/DoPaintRoot { % - => -
    beep
  	
    FrameBuffers {
	true /settrackable 2 index send
	dup setcanvas clippath extenddamageall
    } forall
} def

/ShutDown { % - => -
    /destroy EventManager send
    pause pause pause pause

    FrameBuffers {
	false /settrackable 2 index send
	false /setmenuable  2 index send
        null /setmenu 3 -1 roll send
    } forall
    true setxrootpattern

    UserProfile /UsePaintRoot? false put

    REFRESH

    userdict cleanoutdict
} def

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Initialization

/s 256 string def

/FrameBuffers [
    rootcanvases {
        dup /Parent get globalroot ne { pop } if
    } forall
] def

{   
    FrameBuffers { /SubstructureRedirect get killprocess } forall
} stopped clear

/Windows 300 dict def

/SupportInterests null null
dictbegin
    /UnmapNotify {
	/Action get 
	begin
	    Windows XID known {
		XID xlookupid {
		    pop
		    /opened? Windows XID get send {
			/unmap Windows XID get send
			/unmap currentdict send
		    } {
			Windows XID get /OpenedBy undef
		    } ifelse
		} {
		    Windows XID undef
		} ifelse
	    } if
	end
    } def
    /ClientMessage {
	pop
    } def
    /PropertyNotify {
	begin
	    /xid Canvas /XID get def

	    xid xlookupid {
		pop
	    } {
		Windows xid undef
	    } ifelse
	    Windows xid known {
		Action XGetAtomName {
		    /WM_CLASS {
			/update_sticky Windows xid get send
		    }
		    /WM_NAME {
			Canvas /WM_NAME GetProp {
			    /setlabel Windows xid get send
			} if
		    }
		    /WM_ICON_NAME {
			Canvas /WM_ICON_NAME GetProp {
			    /seticonlabel Windows xid get send
			} if
		    }
		    /WM_PROTOCOLS {
			/UpdateProtocols Canvas send
		    }
		    /WM_NORMAL_HINTS {
			/opened? Windows xid get send 
			not {
			    /place Windows xid get send
			} if
		    } 
		    /_OL_WIN_BUSY {
			Canvas /_OL_WIN_BUSY GetProp {
			    0 getcard32
			} {
			    0
			} ifelse
			0 eq {
			    /Active
			} {
			    /Busy
			} ifelse
			/setvisualstate Windows xid get send
		    }
		    /_OL_DECOR_ADD {
			Windows xid get Canvas 
			UpdateDecor
		    } 
		    /_OL_DECOR_DEL {
			Windows xid get Canvas 
			UpdateDecor
		    } 
		    /_OL_WIN_ATTR {
			Canvas GetPinstate {
			    Windows xid get 
			    /Pinned? 3 -1 roll put
			} if
		    } def
		    /Default {
%			print_tag tagprint
%			Action XGetAtomName 255 string cvs 
%			( change) append typedprint
		    } 
		} case
	    } if
	end
    } def
dictend 
/new ClassInterest send def

/WMInterests
dictbegin
    FrameBuffers { dup def } forall
dictend
null 
dictbegin
    /ClientMessage {
	Debug { dup == } if
	/Action get
	3 dict begin
	    /value exch def
	    /win value 1 getcard32 xlookupid {
		/XID get def
		value 2 getcard32 XGetAtomName /WM_CHANGE_STATE eq {
			value 3 getcard32 3 eq {
			    Windows win known {
				/close Windows win get send
			    } if
			} if
		    } if
	    } if
	end
    } def
    /MapRequest { 
	Debug { dup == } if
	begin
	    Action xlookupid {
		1 dict 
		begin
		    /can exch def

		    can /Parent get dup /descendantof? ClassCanvas send {
			/framebufferof 1 index send eq {
			    pause pause pause
			    can Action BuildWindow
			} if
			
			Windows Action known {
			    /update_sticky Windows Action get send
			    
			    /map can send
			    can /DoMap Windows Action get send
			} if
		    } {
			can /Mapped true put
		    } ifelse
		end
	    } if
	end
    } def

    /ConfigureRequest { 
	Debug { 
	    dup == 
	    dup /Action get /Window get xlookupid {
		==
	    } if
	} if
	/Action get 
	begin
	    Window xlookupid {
		gsave dup begin /Parent get setcanvas
		    Mask 15 and 0 ne {
			Mask 1 and 0 ne {
			    /config_x X def
			} if
			Mask 2 and 0 ne {
			    /config_y Y def
			} if
			Mask 4 and 0 ne {
			    /config_width Width def
			} if
			Mask 8 and 0 ne {
			    /config_height Height def
			} if
			
			Windows Window known {
			    Windows Window get Window xlookupid pop
			    /DoConfig Windows Window get send
			} {
			    0 0 
			    Mask 4 and 0 ne {
				Width
			    } {
				Window xlookupid pop false getbbox 
				pop 3 1 roll pop pop
			    } ifelse
			    Mask 8 and 0 ne {
				Height
			    } {
				Window xlookupid pop false getbbox 
				4 1 roll pop pop pop
			    } ifelse
			    newpath rectpath Window xlookupid pop reshapecanvas
			} ifelse
		    } {
			Windows Window known {
			    Mask 64 and 0 ne {
				/totop Windows Window get send
			    } if
			    /SendConfigure Window xlookupid pop send
			} if
		    } ifelse
		end grestore
	    } if
	end
    } def
    /ResizeRequest {
	==
    } def
dictend 
/new ClassInterest send def

/EventManager /new ClassEventMgr send def
true /setrobust EventManager send

/ic 24 string def
ic 0 64 putcard32
ic 1 64  putcard32
ic 2 64  putcard32
ic 3 64  putcard32
ic 4 1 putcard32
ic 5 1  putcard32

EventManager /ProcessName (OWM EventManager) put
currentprocess /ProcessName (OWM Listener) put

SupportInterests /addclient EventManager send
WMInterests /addclient EventManager send

EventManager suspendprocess

WMInterests /Canvas get {
    pop 
    dup /SubstructureRedirect EventManager put
    dup /WM_ICON_SIZE ic /WM_ICON_SIZE false XInternAtom 32 xsetproperty
    /Eventmask 16#00180000 put
} forall

WrapAllWindows

EventManager continueprocess
