function GetRootPieMenu()
{
  gPieMenuTarget.ValidatePieMenus();
  gRootPieMenu = gPieMenuTarget.rootpiemenu;
  return gRootPieMenu;
}


function HandleOnLoad()
{
}


function InitPieMenuEditor()
{
  gPieMenuID = getAttribute("piemenu");

  gMetaData = new ActiveXObject("Microsoft.XMLDOM");
  gMetaData.async = false;
  gMetaData.load("piemenumetadata.xml");

  var out = "";
  var str;

  gPieMenuTargetID = GenUniqueID();

  out += "<DIV ";
  out += "ID=\"" + gPieMenuTargetID + "\" ";
  out += "STYLE=\"width:100%;height:100;border:3 outset;behavior:url(piemenu.htc)\" ";
  out += "PIEMENU=\"" + gPieMenuID + "\" ";
  out += "ONAFTERMAKEPIE=\"" + gDiv.id + ".LoadPieMenuEditor()\">";
  out += "<CENTER><H1><BR/><BR/>";
  out += "Click here to pop up the pie menu.";
  out += "<BR/><BR/><BR/></H1></CENTER>";
  out += "</DIV>";
  out += "<DIV ID=\"PieMenuTreeView\">";
  out += "</DIV>";
  out += "<DIV ID=\"TableHolder\"/>";

  str = GetDivMetaData("PieMenuPropsDiv").xml;
  str = str.replace(gIDPattern, gDiv.id);
  out += str;

  str = GetDivMetaData("PieItemPropsDiv").xml;
  str = str.replace(gIDPattern, gDiv.id);
  out += str;
  out += "</DIV>";

  gDiv.innerHTML = out;

  gPieMenuTarget = eval(gPieMenuTargetID);
}


function GetDivMetaData(id)
{
  var pattern = 
    "/metadata" +
      "/DIV[@id=\"" + id + "\"]";
  var result =
    gMetaData.selectSingleNode(
      pattern);
  return result;
}


function GetPropMetaData(className, propVarName)
{
  return gMetaData.selectSingleNode(
    "/metadata" +
    "/class[@name=\"" + className + "\"]" +
    "/prop[@var=\"" + propVarName + "\"]");
}


function GetMetaData(className)
{
  return(gMetaData.selectSingleNode("/metadata/class[@name=\"" + className + "\"]"));
}


function LoadPieMenuEditor()
{
  gRootPieMenu = gPieMenuTarget.rootpiemenu;
  gCurPieMenuPath = gDiv.id + ".GetRootPieMenu()";

  UpdatePieMenuView();
}

  
function ValidatePieMenu(pie)
{
  if (pie.items == null) {
    gPieMenuTarget.InitPieMenu(pie);
  } // if
}


function UpdatePieMenuView()
{
  if (gCurPieMenuPath.length > 0) {
//    ValidatePieMenu(eval(gCurPieMenuPath));
  } // if

  UpdatePieMenuTree();
  UpdateCurPieMenu();
}


var gGenUniqueID = 0;

function GenUniqueID()
{
  return "PIEMENUEDITOR_ID_" + (++gGenUniqueID);
}


function MakePathID(path)
{
  var id = "ID_";
  var n = path.length;
  var i;
  for (i = 0; i < n; i++) {
    var ch = path.substr(i, 1);
    if (((ch >= "A") && (ch <= "Z")) ||
        ((ch >= "a") && (ch <= "z")) ||
        ((ch >= "0") && (ch <= "9"))) {
      id += ch;
    } else {
      id += "_";
    } // if
  } // for

  return id;
}


function QuoteXMLText(str)
{
  var result = "";
  var n = str.length;
  var i;
  for (i = 0; i < n; i++) {
    var ch = str.charAt(i);
    if (ch == '&') {
      result += "&amp;";
    } else if (ch == '<') {
      result += "&lt;";
    } else if (ch == '>') {
      result += "&gt;";
    } else {
      result += ch;
    } // if
  } // for i
  return result;
}


function MakePieMenuTreeView(pie, path)
{
  var out = "";
  var id = MakePathID(path);

  out += "<UL><LI ID=\"" + id + "\"><SPAN><B>";
  out += "<A HREF=\"javascript:" +
    gDiv.id + ".ClickPieMenu(this, '" + path + "')\">piemenu</A>";
  out += "</B>: ";
  out += QuoteXMLText(pie.centerDiv.innerText);
  out += "</SPAN>"
  var items = pie.items;
  if (items != null) {
    var itemCount = items.length;
    if (itemCount > 0) {
      out += "<UL>";
      var i;
      for (i = 0; i < itemCount; i++) {
	var it = items[i];
	var itemPath = path + ".items[" + i + "]";
	id = MakePathID(itemPath);
	out += "<LI ID=\"" + id + "\"><SPAN><B>";
	out += "<A HREF=\"javascript:" +
	  gDiv.id + ".ClickPieItem(this, '" + itemPath + "')\">item</A>";
	out += "</B>: ";
	out += QuoteXMLText(it.div.innerText);
	out += "</SPAN>";
	var subPie = it.subPie;
	if (subPie != null) {
	  ValidatePieMenu(subPie);
	  out += MakePieMenuTreeView(subPie, itemPath + ".subPie");
	} // if
	out += "</LI>";
      } // for i
      out += "</UL>";
    } // if
  } // if

  out += "</LI></UL>";

  return out;
}


function UpdatePieMenuTree()
{
  var out = "";

  gPieMenuTarget.ValidatePieMenus();
  gRootPieMenu = gPieMenuTarget.rootpiemenu;

  if (gRootPieMenu != null) {
    out += MakePieMenuTreeView(gRootPieMenu, gDiv.id + ".GetRootPieMenu()");
  } // if

  // Pull these guys safely out of the html tree we are about to replace,
  // so they don't get destroyed. 
  TableHolder.insertAdjacentElement("afterEnd", PieMenuPropsDiv);
  TableHolder.insertAdjacentElement("afterEnd", PieItemPropsDiv);
  PieMenuPropsDiv.style.display = "none";
  PieItemPropsDiv.style.display = "none";

  PieMenuTreeView.innerHTML = out;
}


function HideOutlineSelection()
{
  if (gCurPieMenuPath.length > 0) {
    var id = MakePathID(gCurPieMenuPath);
    var li = eval(id);
    if (li != null) {
      li.firstChild.style.backgroundColor = "";
      li.firstChild.style.border = "";
    } // if
  } // if

  if (gCurPieItemPath.length > 0) {
    var id = MakePathID(gCurPieItemPath);
    var li = eval(id);
    if (li != null) {
      li.firstChild.style.backgroundColor = "";
      li.firstChild.style.border = "";
    } // if
  } // if

  TableHolder.insertAdjacentElement("afterEnd", PieMenuPropsDiv);
  TableHolder.insertAdjacentElement("afterEnd", PieItemPropsDiv);
  PieMenuPropsDiv.style.display = "none";
  PieItemPropsDiv.style.display = "none";
}


function ShowOutlineSelection()
{
  var pieid = null;
  var piediv = null;
  if (gCurPieMenuPath.length > 0) {
    pieid = MakePathID(gCurPieMenuPath);
    piediv = eval(pieid);
    if (piediv != null) {
      piediv.firstChild.style.backgroundColor = "yellow";
      piediv.firstChild.style.border = "3 outset";
    } // if
    PieMenuPropsDiv.style.display = "block";
    piediv.firstChild.insertAdjacentElement("afterEnd", PieMenuPropsDiv);
  } else {
    PieMenuPropsDiv.style.display = "none";
    TableHolder.insertAdjacentElement("afterEnd", PieMenuPropsDiv);
  } // if

  var itemid = null;
  var itemdiv = null;
  if (gCurPieItemPath.length > 0) {
    itemid = MakePathID(gCurPieItemPath);
    itemdiv = eval(itemid);
    if (itemdiv != null) {
      itemdiv.firstChild.style.backgroundColor = "orange";
      itemdiv.firstChild.style.border = "3 outset";
    } // if
    PieItemPropsDiv.style.display = "block";
    itemdiv.firstChild.insertAdjacentElement("afterEnd", PieItemPropsDiv);
  } else {
    if (piediv != null) {
      PieItemPropsDiv.style.display = "block";
      PieMenuPropsDiv.insertAdjacentElement("afterEnd", PieItemPropsDiv);
    } else {
      PieItemPropsDiv.style.display = "none";
      TableHolder.insertAdjacentElement("afterEnd", PieItemPropsDiv);
    } // if
  } // if
}


function ClickPieMenu(view, piePath)
{
  var pie = eval(piePath);

  gPieMenuTarget.ValidatePieMenus();

  HideOutlineSelection();

  gCurPieMenuPath = piePath;
  gCurPieItemPath = "";

  UpdateCurPieMenu();

  ShowOutlineSelection();
}


function ClickPieItem(view, itemPath)
{
  var item = eval(itemPath);

  gPieMenuTarget.ValidatePieMenus();

  HideOutlineSelection();

  gCurPieItemPath = itemPath;

  var ip = "" + itemPath + "";
  var a = itemPath.split(".");
  a = a.slice(0, -1);
  a = a.join(".");
  gCurPieMenuPath = a;

  var curPie = eval(gCurPieMenuPath);
  curPie.curItem = item.index;

  UpdateCurPieMenu();
}


function UpdateCurPieMenu()
{
  UpdatePieMenuEditor();
  UpdatePieItemEditor();
  ShowOutlineSelection();
}


function UpdatePieMenuEditor()
{
  UpdatePinnedPieMenuProps();
  UpdatePieMenuPropSelector();
  SelectPieMenuProp(gCurPieMenuProp);
}


function UpdatePieItemEditor()
{
  UpdateCurPieItem()
  UpdatePinnedPieItemProps();
}


function HidePieItemEditor()
{
    PieItemPropSelectorDiv.innerHTML = "";
    PieItemPropDescription.innerHTML = "";
    PieItemPropEditor.innerHTML = "";

    PieItemPropsRow1.style.display = "none";
    PieItemPropsRow2.style.display = "none";
    PieItemPropsRow3.style.display = "none";

    AddPieItemButton.style.display = "none";
    InsertPieItemButton.style.display = "none";
    AppendPieItemButton.style.display = "none";
    DeletePieItemButton.style.display = "none";
    AddSubMenuButton.style.display = "none";
    DeleteSubMenuButton.style.display = "none";
}


function UpdateCurPieItem()
{
  if (gCurPieMenuPath.length == 0) {
    HidePieItemEditor();
    return;
  } // if

  if (gCurPieItemPath.length == 0) {
    var curPie = eval(gCurPieMenuPath);
    var items = curPie.items;
    if (items != null) {
      if (items.length > 0) {
	var cur = curPie.curItem;
	if ((cur == null) || (cur < 0)) {
	  curPie.curItem = 0;
	  cur = 0;
	} // if
	gCurPieItemPath = gCurPieMenuPath + ".items[" + cur + "]";
      } // if
    } // if
  } // if

  if (gCurPieItemPath.length == 0) {
    HidePieItemEditor();
    AddPieItemButton.style.display = "inline";
    InsertPieItemButton.style.display = "none";
    AppendPieItemButton.style.display = "none";
    return;
  } // if

  var item = eval(gCurPieItemPath);

  PieItemPropsRow1.style.display = "inline";
  PieItemPropsRow2.style.display = "inline";
  PieItemPropsRow3.style.display = "inline";

  AddPieItemButton.style.display = "none";
  InsertPieItemButton.style.display = "inline";
  AppendPieItemButton.style.display = "inline";
  DeletePieItemButton.style.display = "inline";

  if (item.subPie == null) {
    AddSubMenuButton.style.display = "inline";
    DeleteSubMenuButton.style.display = "none";
  } else {
    AddSubMenuButton.style.display = "none";
    DeleteSubMenuButton.style.display = "inline";
  } // if

  UpdatePieItemPropSelector();
  SelectPieItemProp(gCurPieItemProp);
}


function UpdatePieMenuPropSelector()
{
  var PieMenuMetaData =
    GetMetaData("PieMenu");

  var out = "";

  if (gCurPieMenuPath.length > 0) {

    out += "<SELECT";
    out += " ONCHANGE=\"" + gDiv.id + ".SelectPieMenuPropEditor(this)\">";

    var prop;
    var children = PieMenuMetaData.childNodes;
    while ((prop = children.nextNode()) != null) {
      if ((prop.nodeType == 1) &&
	  (prop.nodeName == "prop")) {
	  var propName = GetAttStr(prop, "name", "");
	  var propVar = GetAttStr(prop, "var", "");
	  out += "<OPTION";
	  out += " VALUE=\"" + propVar + "\"";
	  if (propVar == gCurPieMenuProp) {
	    out += " SELECTED=\"SELECTED\"";
	  } // if
	  out += ">";
	  out += propName;
	  out += "</OPTION>";
      } // if
    } // while
    out += "</SELECT>";

  } // if

  PieMenuPropSelectorDiv.innerHTML = out;
}


function SelectPieMenuPropEditor(editor)
{
  var propName = editor.value;
  SelectPieMenuProp(propName);
}

function UpdatePinnedPieMenuProps()
{
  ProcessPinnedProps(
    gCurPieMenuPath,
    "PieMenu",
    gPinnedPieMenuProps,
    PieMenuPinnedProps)
}


function UpdatePinnedPieItemProps()
{
  ProcessPinnedProps(
    gCurPieItemPath,
    "PieItem",
    gPinnedPieItemProps,
    PieItemPinnedProps)
}


function SelectPieMenuProp(propName)
{
  gCurPieMenuProp = propName;

  ProcessSelectedProps(
    gCurPieMenuPath,
    "PieMenu",
    gCurPieMenuProp,
    PieMenuPropDescription,
    PieMenuPropEditor,
    PieMenuPropPinButton)
}


function SelectPieItemPropEditor(editor)
{
  var propName = editor.value;
  SelectPieItemProp(propName);
}

function SelectPieItemProp(prop)
{
  gCurPieItemProp = prop;

  ProcessSelectedProps(
    gCurPieItemPath,
    "PieItem",
    gCurPieItemProp,
    PieItemPropDescription,
    PieItemPropEditor,
    PieItemPropPinButton)
}


function StripWhiteSpace(str)
{
  var ch;
  var len;

  while ((str.length != 0) &&
         (((ch = str.charAt(0)) == ' ') ||
          (ch == '\t') ||
          (ch == '\r') ||
          (ch == '\n'))) {
    str = str.substring(1);
  } // while

  while (((len = str.length) != 0) &&
         (((ch = str.charAt(len - 1)) == ' ') ||
          (ch == '\t') ||
          (ch == '\r') ||
          (ch == '\n'))) {
    str = str.substring(0, str.length - 1);
  } // while

  return str;
}


function ProcessPinnedProps(path, className, pinnedProps, pinnedPropsDiv)
{
  pinnedPropsDiv.innerHTML = "";

  var out = "";

  var n = pinnedProps.length;
  if (n == 0) {
    pinnedPropsDiv.style.display = "none";
  } else {
    var i;
    for (i = 0; i < n; i++) {
      var pinnedPropName = pinnedProps[i];

      out += ProcessOneProp(
	path,
	className,
	pinnedPropName,
	i,
	null,
	null);
      out += "<HR/>";
    } // for i
    pinnedPropsDiv.style.display = "block";
  } // if

  pinnedPropsDiv.innerHTML = out;
}


function ProcessSelectedProps(path, className, propName, descriptionDiv, editorDiv, pinButton)
{
  descriptionDiv.innerHTML = "";
  editorDiv.innerHTML = "";

  var out = ProcessOneProp(
    path,
    className,
    propName,
    -1,
    descriptionDiv,
    pinButton);

  editorDiv.innerHTML = out;
}


function ProcessOneProp(path, className, propName, pinnedIndex, descriptionDiv, pinButton)
{
  var prop = GetPropMetaData(className, propName);
  var propDescription = GetAttStr(prop, "description", "");
  var propVar = GetAttStr(prop, "var", "");
  var propType = GetAttStr(prop, "type", "");
  var propDefault = GetAttStr(prop, "default", "");
  var propVal = propDefault;
  var setPropValCmd = "propVal = " + path + "." + propVar;
  var pathVal = "";

  pathVal = eval(path);

  if (pathVal == null) {
    return "Error: Null pathVal: " + path + "!";
  } // if

  var out = "";

  if (pinnedIndex >= 0) {
    out += "<INPUT ";
    out += "STYLE=\"float:right\" ";
    out += "TYPE=\"BUTTON\" ";
    out += "VALUE=\"UnPin\" ";
    out += "ONCLICK=\"";
    out += gDiv.id + ".UnPin" + className + "Prop(";
    out += pinnedIndex + ");";
    out += "\"/>";
    out += "<B>" + className + " Property:</B> " + propName + "<BR/>";
    out += "<B>Description:</B> " + propDescription + "<BR/>";
  } else {

    descriptionDiv.innerText = propDescription;

  } // if

  var id = GenUniqueID();

  if (propType == "string") {

    eval(setPropValCmd);

    out += "<B>String Value:</B> ";
    out += "<INPUT ";
    out += "ID=\"" + id + "\" ";
    out += " TYPE=\"TEXT\" ";
    out += "SIZE=\"80\" ";
    out += "VALUE=\"" + propVal + "\"/>";
//    out += "<BR/>";
//    out += "<INPUT ";
//    out += "TYPE=\"BUTTON\" ";
//    out += "VALUE=\"Revert\" ";
//    out += "ONCLICK=\"RevertPropString(" +
//      id + ", '" + path + "', '" + className + "', '" + propVar + "')\"/>";
    out += " <INPUT ";
    out += "TYPE=\"BUTTON\" ";
    out += "VALUE=\"Apply\" ";
    out += "ONCLICK=\"" + gDiv.id + ".EditPropString(" +
      id + ", '" + path + "', '" + className + "', '" + propVar + "')\"/>";

  } else if (propType == "enum") {

    eval(setPropValCmd);

    out += "<B>Select Value:</B>";
    out += "<SELECT ";
    out += "ID=\"" + id + "\">";
    var propEnum = GetAttStr(prop, "enum", "");
    var enumValues = propEnum.split(",");
    var i, n = enumValues.length;

    for (i = 0; i < n; i++) {
      var val = enumValues[i];
      out += "<OPTION ";
      out += "VALUE=\"" + val + "\" ";
      if (val == propVal) {
        out += "SELECTED=\"SELECTED\" ";
      }
      out += ">" + val + "</OPTION>"
    } // for
    out += "</SELECT>";
//    out += "<BR/>";
//    out += "<INPUT ";
//    out += "TYPE=\"BUTTON\" ";
//    out += "VALUE=\"Revert\" ";
//    out += "ONCLICK=\"RevertPropEnum(" +
//      id + ", '" + path + "', '" + className + "', '" + propVar + "')\"/>";
    out += " <INPUT ";
    out += "TYPE=\"BUTTON\" ";
    out += "VALUE=\"Apply\" ";
    out += "ONCLICK=\"" + gDiv.id + ".EditPropEnum(" +
      id + ", '" + path + "', '" + className + "', '" + propVar + "')\"/>";

  } else if (propType == "element") {

    propVal = "";
    var propElement = GetAttStr(prop, "element", "");
    var spec = pathVal.spec;
    if (spec != null) {
      var kid = spec.firstChild;
      while (kid != null) {
        if ((kid.nodeType == 1) &&
	    (kid.nodeName == propElement)) {
	  var txt = "";
	  var grandkid = kid.firstChild;
	  while (grandkid != null) {
	    txt += grandkid.xml;
	    grandkid = grandkid.nextSibling;
	  } // while
          propVal += txt;
	} // if
        kid = kid.nextSibling;
      } // while
    } // if

    out += "<B>Element Value:</B><BR/>";
    out += "<TEXTAREA ";
    out += "ID=\"" + id + "\" ";
    out += "COLS=\"80\" ";
    out += "STYLE=\"height:100\">";
    out += propVal;
    out += "</TEXTAREA>";
    out += "<BR/>";
//    out += "<INPUT ";
//    out += "TYPE=\"BUTTON\" ";
//    out += "VALUE=\"Revert\" ";
//    out += "ONCLICK=\"RevertPropElement(" +
//      id + ", '" + path + "', '" + className + "', '" + propVar + "')\"/>";
    out += "<INPUT ";
    out += "TYPE=\"BUTTON\" ";
    out += "VALUE=\"Apply Text\" ";
    out += "ONCLICK=\"" + gDiv.id + ".EditPropElement(" +
      id + ", '" + path + "', '" + className + "', '" + propVar + "', 1)\"/>";
    out += "<INPUT ";
    out += "TYPE=\"BUTTON\" ";
    out += "VALUE=\"Apply HTML\" ";
    out += "ONCLICK=\"" + gDiv.id + ".EditPropElement(" +
      id + ", '" + path + "', '" + className + "', '" + propVar + "', 0)\"/>";
    out += " (using XML syntax)";

  } else if (propType == "bool") {

    eval(setPropValCmd);

    propVal = parseInt(propVal);

    out += "<B>Boolean Value:</B>";
    out += "<INPUT ";
    out += "ID=\"" + id + "\" ";
    out += "TYPE=\"CHECKBOX\" ";
    if (propVal) {
      out += "CHECKED=\"CHECKED\" ";
    } // if
    out += "/>";
//    out += "<BR/>";
//    out += "<INPUT ";
//    out += "TYPE=\"BUTTON\" ";
//    out += "VALUE=\"Revert\" ";
//    out += "ONCLICK=\"RevertPropBool(" +
//      id + ", '" + path + "', '" + className + "', '" + propVar + "')\"/>";
    out += " <INPUT ";
    out += "TYPE=\"BUTTON\" ";
    out += "VALUE=\"Apply\" ";
    out += "ONCLICK=\"" + gDiv.id + ".EditPropBool(" +
      id + ", '" + path + "', '" + className + "', '" + propVar + "')\"/>";

  } else if (propType == "int") {

    eval(setPropValCmd);

    out += "<B>Integer Value:</B> ";
    out += "<INPUT TYPE=\"TEXT\"";
    out += " ONCHANGE=\"" + gDiv.id + ".EditPropInt(this, '" + path + "', '" + className + "', '" + propVar + "')\"";
    out += " SIZE=\"20\"";
    out += " VALUE=\"" + propVal + "\"/>";
//    out += "<BR/>";
//    out += "<INPUT ";
//    out += "TYPE=\"BUTTON\" ";
//    out += "VALUE=\"Revert\" ";
//    out += "ONCLICK=\"RevertPropInt(" +
//      id + ", '" + path + "', '" + className + "', '" + propVar + "')\"/>";
    out += " <INPUT ";
    out += "TYPE=\"BUTTON\" ";
    out += "VALUE=\"Apply\" ";
    out += "ONCLICK=\"" + gDiv.id + ".EditPropInt(" +
      id + ", '" + path + "', '" + className + "', '" + propVar + "')\"/>";

  } else if (propType == "float") {

    eval(setPropValCmd);

    out += "<B>Floating Point Value:</B> ";
    out += "<INPUT ";
    out += "ID=\"" + id + "\" ";
    out += "TYPE=\"TEXT\" ";
    out += "SIZE=\"20\" ";
    out += "VALUE=\"" + propVal + "\"/>";
//    out += "<BR/>";
//    out += "<INPUT ";
//    out += "TYPE=\"BUTTON\" ";
//    out += "VALUE=\"Revert\" ";
//    out += "ONCLICK=\"RevertPropFloat(" +
//      id + ", '" + path + "', '" + className + "', '" + propVar + "')\"/>";
    out += " <INPUT ";
    out += "TYPE=\"BUTTON\" ";
    out += "VALUE=\"Apply\" ";
    out += "ONCLICK=\"" + gDiv.id + ".EditPropFloat(" +
      id + ", '" + path + "', '" + className + "', '" + propVar + "')\"/>";

  } else if (propType == "color") {

    eval(setPropValCmd);

    out += "<B>Color Value:</B> ";

    out += "<SELECT ONCHANGE=\"" + id + ".value = this.value;\">";
    var found = 0;
    var n = gColorNames.length;
    var i;
    for (i = 0; i < n; i++) {
      var colorName = gColorNames[i];
      out += "<OPTION VALUE=\"" + colorName + "\"";
      if (colorName == propVal) {
        out += " SELECTED=\"SELECTED\"";
        found = 1;
      } // if
      out += ">" + colorName + "</OPTION>";
    } // for i
    if (!found) {
      out += "<OPTION VALUE=\"" + propVal + "\" SELECTED=\"SELECTED\">";;
      out += propVal + "</OPTION>";
    } // if
    out += "</SELECT> ";
    
    out += "<INPUT ";
    out += "ID=\"" + id + "\" ";
    out += "TYPE=\"TEXT\" ";
    out += "SIZE=\"20\" ";
    out += "VALUE=\"" + propVal + "\"/>";
//    out += "<BR/>";
//    out += "<INPUT ";
//    out += "TYPE=\"BUTTON\" ";
//    out += "VALUE=\"Revert\" ";
//    out += "ONCLICK=\"RevertPropColor(" +
//      id + ", '" + path + "', '" + className + "', '" + propVar + "')\"/>";
    out += " <INPUT ";
    out += "TYPE=\"BUTTON\" ";
    out += "VALUE=\"Apply\" ";
    out += "ONCLICK=\"" + gDiv.id + ".EditPropColor(" +
      id + ", '" + path + "', '" + className + "', '" + propVar + "')\"/>";

  } else if (propType == "widget") {

    var propWidget = GetAttStr(prop, "widget", "");

    out += "<CENTER><DIV STYLE=\"width:100%;border:2 inset;padding:8\" ONMOUSEDOWN=\"" + gDiv.id + ".DoPie(" + path + ");\">";

    gPieMenuTarget.ValidatePieMenus();

    if (pathVal.items != null) {
      gPieMenuTarget.DeHilitePieMenu(pathVal);
    } // if

    var oldDisplay = pathVal.div.style.display;
    var oldPosition = pathVal.div.style.position;
    var oldLeft = pathVal.div.style.left;
    var oldTop = pathVal.div.style.top;
    var oldWidth = pathVal.div.style.width;
    var oldHeight = pathVal.div.style.height;
    pathVal.div.style.display = "inline";
    pathVal.div.style.position = "relative";
    pathVal.div.style.left = "0";
    pathVal.div.style.top = "0";

    pathVal.div.style.width = pathVal.w;
    pathVal.div.style.height = pathVal.h;

    var str = pathVal.div.outerHTML;

    pathVal.div.style.display = oldDisplay;
    pathVal.div.style.position = oldPosition;
    pathVal.div.style.width = oldWidth;
    pathVal.div.style.height = oldHeight;
    pathVal.div.style.left = oldLeft;
    pathVal.div.style.top = oldTop;

    out += str;
    out += "</DIV></CENTER>";

  } else {

    out += "Unknown property type \"" + propType + "\"!";

  } // if

  return out;
}


function PinPieMenuProp(propName)
{
  gPinnedPieMenuProps.push(propName);
  UpdateCurPieMenu();
}


function PinPieItemProp(propName)
{
  gPinnedPieItemProps.push(propName);
  UpdateCurPieMenu();
}


function UnPinPieMenuProp(pinnedPropIndex)
{
  gPinnedPieMenuProps.splice(pinnedPropIndex, 1);
  UpdateCurPieMenu();
}


function UnPinPieItemProp(pinnedPropIndex)
{
  gPinnedPieItemProps.splice(pinnedPropIndex, 1);
  UpdateCurPieMenu();
}


function DoPie(pie)
{
  gPieMenuTarget.DoPie(pie);
}


function UpdatePieItemPropSelector()
{
  var PieMenuMetaData = 
    GetMetaData("PieItem");

  var out = "";

  if (gCurPieMenuPath.length > 0) {

    out += "<SELECT";
    out += " ONCHANGE=\"" + gDiv.id + ".SelectPieItemPropEditor(this)\">";

    var prop;
    var children = PieMenuMetaData.childNodes;
    while ((prop = children.nextNode()) != null) {
      if ((prop.nodeType == 1) &&
	  (prop.nodeName == "prop")) {
	  var propName = GetAttStr(prop, "name", "");
	  var propVar = GetAttStr(prop, "var", "");
	  out += "<OPTION";
	  out += " VALUE=\"" + propVar + "\"";
	  if (propVar == gCurPieItemProp) {
	    out += " SELECTED=\"SELECTED\"";
	  } // if
	  out += ">";
	  out += propName;
	  out += "</OPTION>";
      } // if
    } // while
    out += "</SELECT>";

  } // if

  PieItemPropSelectorDiv.innerHTML = out;
}


function ChangedProp(prop, path, className, propName, propVal)
{
  var obj = eval(path);

  var att = "";
  var spec = obj.spec;
  if (spec != null) {
    var att = GetAttStr(prop, "att", "");
    if (att.length > 0) {
      val = propVal + "";
      spec.setAttribute(att, val);
    } // if
  } // if

  gPieMenuTarget.InvalidatePieMenus();
  UpdatePieMenuTree();
  UpdateCurPieMenu();
}


function EditPropString(editor, path, className, propName)
{
  var obj = eval(path);

  if (obj != null) {
    var prop =
      GetPropMetaData(className, propName);

    var propVar =
      GetAttStr(prop, "var", "");

    var propVal =
      editor.value;

    var cmd =
      path + "." + propVar + " = propVal;";

    eval(cmd);

    ChangedProp(prop, path, className, propName, propVal);
  } // if

}


function RevertPropString(editor, path, className, propName)
{
  // TODO ...
}


function EditPropElement(editor, path, className, propName, isText)
{
  var obj = eval(path);

  if (obj != null) {
    var prop =
      GetPropMetaData(className, propName);

    var propElement =
      GetAttStr(prop, "element", "");

    var propVal =
      editor.value;


    if (isText) {
      propVal = QuoteXMLText(propVal);
    } else {
      propVal = StripWhiteSpace(propVal);

      if (propVal.length != 0) {
	propVal = "\n" + propVal + "\n";
      } // if

    } // if

    // Delete the old element.
    var spec = obj.spec;
    if (spec != null) {
      var kid = spec.firstChild;
      var toRemove = new Array();
      while (kid != null) {
	if ((kid.nodeType == 1) &&
	    (kid.nodeName == "html")) {
	  toRemove[toRemove.length] = kid;
	} // if
	kid = kid.nextSibling;
      } // while
      var i;
      var n = toRemove.length;
      for (i = 0; i < n; i++) {
	spec.removeChild(toRemove[i]);
      } // for i
    } // if

    // If the string is not empty, then add a new element.
    if (propVal.length > 0) {
      
      var insertDoc = new ActiveXObject("Microsoft.XMLDOM");
      insertDoc.loadXML("<" + propElement + ">" + propVal + "</" + propElement + ">");
      var newNode = insertDoc.firstChild;

      if (spec.hasChildNodes()) {
//        spec.insertBefore(newNode, spec.firstChild);
//Barf.innerText += "XXX: " + spec;
        spec.appendChild(newNode);
      } else {
        spec.appendChild(newNode);
      } // if

    } // if

    ChangedProp(prop, path, className, propName, propVal);

  } // if

}


