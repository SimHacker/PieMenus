  <COMPONENT ID="piemenueditor">

    <IMPLEMENTS ID="piemenueditor" TYPE="Behavior" DEFAULT="">
      <ATTACH FOR="window" EVENT="onload" handler="HandleOnLoad"/>
      <PUBLIC>
        <EVENT NAME="OnFooBar" ID="evFooBar"/>
      </PUBLIC>
    </IMPLEMENTS>

    <IMPLEMENTS TYPE="Automation">
      <PUBLIC>
        <METHOD NAME="LoadPieMenuEditor"/>
        <METHOD NAME="ClickPieMenu"/>
        <METHOD NAME="ClickPieItem"/>
        <METHOD NAME="AddPieItem"/>
        <METHOD NAME="InsertPieItem"/>
        <METHOD NAME="AppendPieItem"/>
        <METHOD NAME="DeletePieItem"/>
        <METHOD NAME="AddSubMenu"/>
        <METHOD NAME="DeleteSubMenu"/>
        <METHOD NAME="GetRootPieMenu"/>
	<METHOD NAME="SelectPieMenuPropEditor"/>
	<METHOD NAME="SelectPieItemPropEditor"/>
	<METHOD NAME="PinPieMenuProp"/>
	<METHOD NAME="PinPieItemProp"/>
	<METHOD NAME="UnPinPieMenuProp"/>
	<METHOD NAME="UnPinPieItemProp"/>
	<METHOD NAME="DoPie"/>
	<METHOD NAME="EditPropString"/>
	<METHOD NAME="EditPropInt"/>
	<METHOD NAME="EditPropEnum"/>
	<METHOD NAME="EditPropElement"/>
	<METHOD NAME="EditPropBool"/>
	<METHOD NAME="EditPropFloat"/>
	<METHOD NAME="EditPropColor"/>

        <PROPERTY NAME="piemenu" INTERNALNAME="gPieMenuID"/>
        <PROPERTY NAME="target" INTERNALNAME="gDiv"/>
        <PROPERTY NAME="curpiemenuprop" INTERNALNAME="gCurPieMenuProp"/>
        <PROPERTY NAME="curpieitemprop" INTERNALNAME="gCurPieItemProp"/>
      </PUBLIC>
    </IMPLEMENTS>

    <SCRIPT LANGUAGE="JScript">


////////////////////////////////////////////////////////////////////////
