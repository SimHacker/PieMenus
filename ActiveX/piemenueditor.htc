function GetAttStr(node, name, def)
{
  var val = 
    node.getAttribute(name);
  if (val == null) {
    val = def;
  } // if

  return val;
}


function GetAttFloat(node, name, def)
{
  var val = 
    GetAttStr(node, name, "");

  var ival =
    parseFloat(val);

  if (isNaN(ival)) {
    ival = def;
  } // if

  return ival;
}


function GetAttInt(node, name, def)
{
  var val = 
    GetAttStr(node, name, "");

  var ival =
    parseInt(val);

  if (isNaN(ival)) {
    ival = def;
  } // if

  return ival;
}


function GetAttBool(node, name, def)
{
  var val = 
    GetAttStr(node, name, "");

  var ival =
    parseInt(val);

  if (isNaN(ival)) {
    var lowerVal =
      val.toLowerCase();
    if ((lowerVal == "1") ||
        (lowerVal == "true") ||
        (lowerVal == "t") ||
        (lowerVal == "yes") ||
        (lowerVal == "y") ||
        (lowerVal == "on")) {
      ival = 1;
    } else if ((lowerVal == "0") ||
               (lowerVal == "false") ||
               (lowerVal == "f") ||
               (lowerVal == "no") ||
               (lowerVal == "n") ||
               (lowerVal == "off")) {
      ival = 0;
    } else {
      ival = def;
    } // if
  } // if

  if (ival) {
    ival = 1;
  } else {
    ival = 0;
  } // if

  return ival;
}


