/Char Object
dictbegin
  /xoffset null def
  /yoffset null def
  /llx null def
  /lly null def
  /urx null def
  /ury null def
  /bbox-width null def
  /bbox-height null def
dictend
classbegin
  /new { % xoffset yoffset llx lly urx ury => obj
    /new super send
    begin
      [/ury /urx /lly /llx /yoffset /xoffset]
      {exch def} forall
      /bbox-width urx llx sub def
      /bbox-height ury lly sub def
      currentdict
    end
  } def

  /get-char-width { % - => xoffset yoffset
    xoffset yoffset
  } def

  /get-char-bbox { % - => llx lly urx ury
    llx lly urx ury
  } def

  /char-build {
    get-char-width setcharwidth
    char-show
  } def

  /char-show {
    char-path char-fill
  } def

  /char-path { % - => -
    SubClassResponsibility
  } def

  /char-fill { % - => -
    SubClassResponsibility
  } def

classend def

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

/FlagChar Char
[/flag-name /flag-size]
classbegin

  /new { % [w h] (name) func => obj
    2.5 0  0 0 2 2
    /new super send begin
      /flag-proc exch def
      /flag-name exch def
      /flag-scale exch def
    currentdict end
  } def

  /char-path {
    0 0 1 1 rectpath
  } def

  /char-show {
    true flag-proc
  } def

  /char-fill //char-show def

/flagsize 95 def

/edef { exch def } def
/nscale { exch div 1 scale } def

/blue	{ 0 0 1 } def
/yellow	{ 1 1 0 } def
/green	{ 0 1 0 } def
/red	{ 1 0 0 } def
/black	{ 0 0 0 } def
/white	{ 1 1 1 } def

/ssetrgbcolor {			% r g b ssetrgbcolor -
    colorcanvas
	{ setrgbcolor }
	{ .3 mul exch .6 mul add exch .1 mul add setgray }
	ifelse
} def

/filled-circle {		% color x y rad filled-circle -
    gsave
    0 360 arc
    ssetrgbcolor
    fill
    grestore
} def

/filled-box {			% color llx lly urx ury filled-box -
    10 dict begin
    gsave
    /ury edef
    /urx edef
    /lly edef
    /llx edef
    newpath
    llx lly moveto
    llx ury lineto
    urx ury lineto
    urx lly lineto
    closepath
    ssetrgbcolor
    fill
    grestore
    end
} def


/box {				% llx lly urx ury box -
    4 dict begin
    /ury edef
    /urx edef
    /lly edef
    /llx edef
    newpath
    llx lly moveto
    llx ury lineto
    urx ury lineto
    urx lly lineto
    closepath
    stroke
    end
} def

/background {		% color background -
    0 0 1 1 filled-box
} def

/frame {			% yscale xscale frame -
    gsave
    nscale
    0 0 1 1 box
    grestore
} def

/std-cross {			% color std-cross -
    3 dict begin
    /b edef
    /g edef
    /r edef
    newpath
    r g b 0 .4 1 .6 filled-box
    r g b .25 0 .4 1 filled-box
    end
} def

/diag-cross {			% color diag-cross -
    gsave
    ssetrgbcolor

    newpath
    0 .05 moveto
    .95 1 lineto
    1 1 lineto
    1 .95 lineto
    .05 0 lineto
    0 0 lineto
    closepath
    fill

     0 .95 moveto
    .95 0 lineto
    1 0 lineto
    1 .05 lineto
    0.05 1 lineto
    0 1 lineto
    closepath
    fill
    grestore
} def

/thin-diag-cross {			% color thin-diag-cross -
    gsave
    ssetrgbcolor

    newpath
    0 .03 moveto
    .97 1 lineto
    1 1 lineto
    1 .97 lineto
    .03 0 lineto
    0 0 lineto
    closepath
    fill

     0 .97 moveto
    .97 0 lineto
    1 0 lineto
    1 .03 lineto
    0.03 1 lineto
    0 1 lineto
    closepath
    fill
    grestore
} def

/cross-template {		% cross-color background-color yscale xscale cross-template -
    gsave
    nscale
    background
    std-cross
    grestore
} def

/thin-cross {			% color yscale xscale thin-cross
    3 dict begin
    gsave
    nscale
    /b edef
    /g edef
    /r edef
    r g b 0 .44 1 .56 filled-box
    r g b .28 0 .37 1 filled-box
    grestore
    end
} def

/vertical-stripe-template {	% left mid right yscale xscale vertical-stripe-template -
    gsave
    nscale
    white background
    2 3 div 0 1 1 filled-box
    1 3 div 0 2 3 div 1 filled-box
    0 0 1 3 div 1 filled-box
    grestore
} def

/horizontal-stripe-template {	% top mid bottom yscale xscale horizontal-stripe-template -
    gsave
    nscale
    white background
    0   0	  1   1 3 div	filled-box
    0   1 3 div	  1   2 3 div	filled-box
    0   2 3 div	  1   1		filled-box
    grestore
} def

/star {
    newpath
    moveto
    -0.0125  0.005	rmoveto
     0.01    0		rlineto
     0.0025  0.01	rlineto
     0.0025 -0.01	rlineto
     0.01    0		rlineto
    -0.0075 -0.006	rlineto
     0.004  -0.009	rlineto
    -0.009   0.005	rlineto
    -0.009  -0.005	rlineto
     0.004   0.009	rlineto
%   -0.0075  0.006	rlineto
    closepath
    fill
} def

/legend {			% (text) legend -
%    .1 0 moveto show
pop
} def

/pickmin {			% x y pickmin min(x,y)
    2 dict begin
    /y edef
    /x edef
    x y lt { x } { y } ifelse
    end
} def

/doflag {			% index doflag -
    10 dict begin
    /i edef
    gsave
    0 .15 translate
    .6 .6 scale
    true flag-routines i get cvx exec
    grestore
    country-names i get legend
    end
} def

/UK {
    gsave
	1 2 nscale
	blue background
	white 0 .4 1 .6 filled-box
	white .425 0 .575 1 filled-box
	white diag-cross
	red thin-diag-cross
	red 0 .44 1 .56 filled-box
	red .455 0 .545 1 filled-box
	grestore
    { 1 2 frame } if
} def

classend def

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

100 dict begin

/FontType 3 def
/FontMatrix [1 0 0 1 0 0] def
/FontBBox [0 0 1 1] def
/Encoding [
  (a) 0 get {/.notdef} repeat

    /Austria
    /Australia
    /Belgium
    /Bulgaria
    /Canada
    /Colombia
    /Czechoslovakia
    /Denmark
    /Finland
    /France
    /Greece
    /Iceland
    /Ireland
    /Israel
    /Italy
    /Japan
    /Luxembourg
    /Netherlands
    /New-Zealand
    /Norway
    /Sweden
    /Switzerland
    /Thailand
    /United-Kingdom
    /USA
    /West-Germany

  counttomark 128 exch sub {/.notdef} repeat
  ] def

/CharProcs 300 dict def
CharProcs begin

  /.notdef null def

/Austria [2 3] (Austria)
{
    red white red 2 3 horizontal-stripe-template
    { 2 3 frame } if
} /new FlagChar send def

/Australia [1 2] (Australia)
{
    /frame? edef
    gsave
	1 2 nscale
	blue background
	grestore
    gsave
	.5 .5 scale
	0 1 translate
	false UK
	grestore
    frame? { 1 2 frame } if
} /new FlagChar send def

/Belgium [13 15] (Belgium)
{
    black yellow red 13 15 vertical-stripe-template
    { 13 15 frame } if
} /new FlagChar send def

/Bulgaria [3 5] (Bulgaria)
{
    white green red 3 5 horizontal-stripe-template
    { 3 5 frame } if
} /new FlagChar send def

/Canada [8 17] (Canada)
{
    gsave
    8 17 nscale
    red 25 34 div 0 1 1 filled-box
    white 9 34 div 0 25 34 div 1 filled-box
    red 0 0 9 34 div 1 filled-box
    9 34 div 0 translate
    8 17 div 1 scale
    red ssetrgbcolor
    newpath
    .48 .1 moveto
    .52 .1 lineto
    .51 .35 lineto
    .7 .33 lineto
    .67 .4 lineto
    .8 .55 lineto
    .77 .58 lineto
    .8 .65 lineto
    .75 .63 lineto
    .74 .67 lineto
    .575 .55 lineto
    .6 .8 lineto
    .55 .75 lineto
    .5 .85 lineto % point of symetry
    .45 .75 lineto
    .4 .8 lineto
    .425 .55 lineto
    .26 .67 lineto
    .25 .63 lineto
    .2 .65 lineto
    .23 .58 lineto
    .2 .55 lineto
    .33 .4 lineto
    .3 .33 lineto
    .49 .35 lineto
    closepath
    fill
    grestore
    { 8 17 frame } if
} /new FlagChar send def

/Colombia [2 3] (Colombia)
{
    gsave
	2 3 nscale
	yellow background
	blue 0 .25 1 .5  filled-box
	red  0 0   1 .25 filled-box
	grestore
    { 2 3 frame } if
} /new FlagChar send def

/Czechoslovakia [2 3] (Czechoslovakia)
{
    gsave
	2 3 nscale
	white background
	red 0 0 1 .5 filled-box
	blue ssetrgbcolor
	0 0 moveto
	.5 .5 lineto
	0 1 lineto
	closepath
	fill
	grestore
    { 2 3 frame } if
} /new FlagChar send def

/Denmark [28 37] (Denmark)
{
    /frame? edef
    white red 28 37 cross-template
    frame? { 28 37 frame } if
} /new FlagChar send def

/Finland [11 18] (Finland)
{
    blue white 11 18 cross-template
    { 11 18 frame } if
} /new FlagChar send def

/France [2 3] (France)
{
    blue white red 2 3 vertical-stripe-template
    { 2 3 frame } if
} /new FlagChar send def

/Greece [2 3] (Greece)
{
    gsave
      2 3 nscale
      white background
      0 1 4.5 div .99 { /y edef blue 0 y 1 y 1 9 div add filled-box } for
      grestore
    gsave
       0 4 9 div translate
       5 9 div dup scale
       blue background
       white std-cross
       grestore
    { 2 3 frame } if
} /new FlagChar send def

/Iceland [18 25] (Iceland)
{
    white blue 18 25 cross-template
    red 18 25 thin-cross
    { 18 25 frame } if
} /new FlagChar send def

/Ireland [1 2] (Ireland)
{
    green white yellow 1 2 vertical-stripe-template
    { 1 2 frame } if
} /new FlagChar send def

/Israel [8 11] (Israel)
{
    /frame? edef
    gsave
	8 11 nscale
	white background
	blue 0 14 173 div 1 44 173 div filled-box
	blue 0 129 173 div 1 159 173 div filled-box
	newpath
	.5 .65 moveto
	.4 .42 lineto
	.6 .42 lineto
	closepath
	.5 .35 moveto
	.4 .58 lineto
	.6 .58 lineto
	closepath
	blue ssetrgbcolor
	stroke
	grestore
    frame? { 8 11 frame } if
} /new FlagChar send def

/Italy [2 3] (Italy)
{
    green white red 2 3 vertical-stripe-template
    { 2 3 frame } if
} /new FlagChar send def

/Japan [2 3] (Japan)
{
    /frame? edef
    gsave
	2 3 nscale
	white background
	grestore
    red .5 3 mul 2 div .5 .3 filled-circle
    frame? { 2 3 frame } if
} /new FlagChar send def

/Luxembourg [3 5] (Luxembourg)
{
    red white blue 3 5 horizontal-stripe-template
    { 3 5 frame } if
} /new FlagChar send def

/Netherlands [2 3] (Netherlands)
{
    red white blue 2 3 horizontal-stripe-template
    { 2 3 frame } if
} /new FlagChar send def

/New-Zealand [1 2] (New Zealand)
{
    /frame? edef
    gsave
	1 2 nscale
	blue background
	grestore
    gsave
	.5 .5 scale
	0 1 translate
	false UK exec
	grestore
    frame? { 1 2 frame } if
} /new FlagChar send def

/Norway [8 11] (Norway)
{
    white red 8 11 cross-template
    blue 8 11 thin-cross
    { 8 11 frame } if
} /new FlagChar send def

/Sweden [5 8] (Sweden)
{
    yellow blue 5 8 cross-template
    { 5 8 frame } if
} /new FlagChar send def

/Switzerland [1 1] (Switzerland)
{
    10 dict begin
    gsave
	1 1 nscale
	red background
	/w .1 def				% half-width
	/l 1 2 7 mul 6 div add w mul def	% half-length
	white .5 l sub .5 w sub .5 l add .5 w add filled-box
	white .5 w sub .5 l sub .5 w add .5 l add filled-box
	grestore
    { 1 1 frame } if
    end
} /new FlagChar send def

/Thailand [2 3] (Thailand)
{
    gsave
	2 3 nscale
	red background
	white 0 1 6 div 1 5 6 div filled-box
	blue  0 1 3 div 1 2 3 div filled-box
	grestore
    { 2 3 frame } if
} /new FlagChar send def

/United-Kingdom [1 2] (United Kingdom)
{ UK } /new FlagChar send def

/USA [10 19] (USA)
{
    2 dict begin
    gsave
    10 19 nscale
    white background
    0 1 6.5 div .99 { /y edef red 0 y 1 y 1 13 div add filled-box } for
    blue 0 6 13 div .4 1 filled-box
    white ssetrgbcolor
    0 1 4 {
	/y edef
	0 1 5 {
	    /x edef
	    newpath
	    x .065 mul .03 add y .095 mul .54 add star
	} for
    } for
    0 1 3 {
	/y edef
	0 1 4 {
	    /x edef
	    newpath
	    x .065 mul .06 add y .095 mul .58 add star
	} for
    } for
    black ssetrgbcolor
    grestore
    { 10 19 frame } if
    end
} /new FlagChar send def

/West-Germany [3 5] (West Germany)
{
    black red yellow 3 5 horizontal-stripe-template
    { 3 5 frame } if
} /new FlagChar send def


end % CharProcs

/BuildChar {
%  (building %\n) [2 index] dbgprintf
  exch begin
  Encoding exch get
  CharProcs exch get
  end
  dup null ne {
    /char-build exch send
  } {pop} ifelse
  pause
} def

currentdict end

/FlagFont exch definefont pop

framebuffer setcanvas
erasepage
/FlagFont findfont 30 scalefont setfont
10 10 moveto
(abcdefgh) show
