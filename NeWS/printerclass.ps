%===================== Tests & Demos =====================
/po { % obj => - (print object)
    /tab {(        )print} def
    {   exch =
	dup type [
	    /dicttype {
		tab dup length exch maxlength (dictionary[%:%]\n) printf
		%dup {pop (% ) printf} forall
	    }
	    /arraytype {
	        dup xcheck {
	            tab ==
	        } {
	            dup length 0 eq {
	                tab ==
	            }{
	                {tab =} forall
	            } ifelse
	        } ifelse
	    }
	    /Default {tab =}
	] case
    } forall
} def
