/fingertip-y .551 def % finger tip @ (1, fingertip-y)

/pointer-path { % fx fy tx ty size fingers? => -
  10 dict begin
    /fingers? exch def  /size exch def
    /ty exch def  /tx exch def  /fy exch def  /fx exch def
    /dx tx fx sub def  /dy ty fy sub def
    /ang dy dx atan def
    /mat matrix currentmatrix def
    fx fy moveto
    tx ty translate
    ang rotate
    size dup .75 mul scale
    -1 fingertip-y neg translate %  finger tip to 0,0
    open-pointing-hand
    closepath
    fingers? { pointing-fingers } if
    mat setmatrix
  end % localdict
} def

/get-pointer {
    fboverlay setcanvas
    getclick
    /FromY exch def /FromX exch def
    FromX FromY
    { x0 y0 x y 64 false pointer-path fill }
    getanimated
    waitprocess aload pop
    /ToY exch def /ToX exch def
} def

end % systemdict

%get-pointer 
%FromX FromY (From) popmsg pop
%ToX ToY (To) popmsg pop

/newfont 50 dict def
newfont begin

/PaintType 1 def
/FontType 3 def
/FontMatrix [1 0 0 1 0 0] def
/FontBBox [0 0 0 0] def
/IsFixedPitch false def
/FontName /Pointer def
/Encoding StandardEncoding def

/CharProcs 300 dict def
CharProcs begin

/a {
  newpath
  0 0 2 0 1 true pointer-path
  2 0
  0 fingertip-y neg 2 1 fingertip-y sub
  setcachedevice
% pop pop pop pop setcharwidth
  0 setlinewidth
  0 setgray stroke
} def

/b {
  newpath
  0 0 2 0 1 false pointer-path
  2 0
  0 fingertip-y neg 2 1 fingertip-y sub
  gsave points2rect rectpath pathbbox grestore
  setcachedevice
% pop pop pop pop setcharwidth
  0 setgray fill
} def

end % CharProcs

/BuildChar {
  exch begin
    Encoding exch get
    CharProcs 1 index known {
      CharProcs exch get
      cvx exec
    } {
      pop newpath
    } ifelse
  end
} def

end % newfont

/Pointer newfont definefont pop

systemdict begin

/point-cursor { % ang => -
  10 dict begin
    /ang exch def
    /Pointer findfont 32 scalefont
    [ ang cos  ang sin
      ang sin neg  ang cos
      0  0 ] makefont
    65 66 setcanvascursor
  end
} def

/PointPieMenu PieMenu
dictbegin
  
dictend
classbegin
  /DragProc {
    /DragProc super send
    MenuValue null eq {
      /beye /beye_m MenuCanvas setstandardcursor
    } {
      gsave MenuCanvas setcanvas
	MenuItems MenuValue get /ang get
	point-cursor
      grestore
    } ifelse
  } def
classend def

PointPieMenu setdefaultmenu

end % systemdict

framebuffer setcanvas
erasepage

/Pointer findfont 32 scalefont setfont

% Load up the cache!

clippath pathbbox /H exch def /W exch def pop pop
W 2 div H 2 div moveto

800 200 translate

20 {
  0 0 moveto
  1 setgray
  (aabb) show
  30 rotate
  pause pause
} repeat

%2 { 0 360 127 div 360 { point-cursor .01 60 div sleep } for } repeat 

