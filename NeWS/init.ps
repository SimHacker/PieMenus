% filename => -
% Take a filename and construct the command line
%	psh $NEWSHOME/demo/filename
% and then do forkunix on it.  *** This works for psh scripts only. ***

/RunDemoPshScript {			% filename
    (psh ) (NEWSHOME) getenv append	% filename (psh $NEWSHOME)
    (/demo/) append			% filename (psh $NEWSHOME/demo/)
    exch append				% (psh $NEWSHOME/demo/filename)
    forkunix
} def


% filename => -
% Take a filename and construct the command line
%	$NEWSHOME/demo/filename
% and then do forkunix on it.  This works for binaries and for csh and sh
% scripts.

/RunDemoProgram {
    (NEWSHOME) getenv (/demo/) append	% filename ($NEWSHOME/demo/)
    exch append				% ($NEWSHOME/demo/filename)
    forkunix
} def

(NeWS/litemenu.ps) LoadFile { 
  (NeWS/piemenu.ps) LoadFile pop
  (NeWS/softmenu.ps) LoadFile pop
% Default Root Menu; here so user.ps can over-ride & modify.
    /ntermmenu [
        % Console gets autolinewrap turned on and 400 lines
	(VT102 Console)	 { (nterm -C -aw -sl 400) forkunix } 
	(VT102)		 { (nterm) forkunix } 
    ] /new DefaultMenu send def
    /fixedterminalmenu [
	(Console)	 { (psterm -f -C -t h19) forkunix } 
	(bitgraph)	 { (psterm -f -t bitgraph) forkunix } 
	(H19)		 { (psterm -f -t h19) forkunix } 
	(tvi925)	 { (psterm -f -t tvi925) forkunix } 
	(sun)		 { (psterm -f -t sun) forkunix } 
	(aaa)		 { (psterm -f -t aaa) forkunix }
	(vt100)		 { (psterm -f -t vt100) forkunix } 
	(wyse)		 { (psterm -f -t wyse) forkunix } 
    ] /new DefaultMenu send def
    /terminalmenu [
	(Fixed =>)	 fixedterminalmenu
	(Console)	 { (psterm -C -t h19) forkunix } 
	(H19)		 { (psterm -t h19) forkunix } 
	(H19 32)	 { (psterm -t h19 -li 32) forkunix }
	(H19 48)	 { (psterm -t h19 -li 48) forkunix }
	(Scrolling =>)	 ntermmenu
	(wyse)		 { (psterm -t wyse) forkunix } 
	(vt100)		 { (psterm -t vt100) forkunix } 
	(aaa)		 { (psterm -t aaa) forkunix } 
	(sun)		 { (psterm -t sun) forkunix } 
    ] /new DefaultMenu send def
    /clockmenu [
	(Plain (seconds)) { (roundclock -s) RunDemoProgram }
	(Plain)		  { (roundclock) RunDemoProgram }
	(Fancy (seconds)) { (roundclock -f -s) RunDemoProgram }
	(Fancy)		  { (roundclock -f) RunDemoProgram }
    ] /new DefaultMenu send def
    /applicationsmenu [
	(Terminals =>)	 terminalmenu
	(Clocks =>)	 clockmenu
	(Load Average)	 { (psload) forkunix }
	(Calculator)	 { (calcul) RunDemoPshScript } 
	(Journal)	 { (journalling) RunDemoPshScript } 
    ] /new DefaultMenu send def

    /AllWin { % proc => - (Distributes proc to all windows!!)
	createevent dup begin
	    /Name /DoItEvent def
	    /Action /Window def
	    /ClientData 2 index def
	end sendevent pop
    } def

    /repairmenu [
	(Repaint All)	{ PaintRoot {/paint self send} AllWin }
	(Reset Input)	{
			createevent dup begin
			    /Name
			      UserProfile /ViewStop known {
				UserProfile /ViewStop get
			      } {
				16#6f01		%  default to L1
			      } ifelse def
			    /Action /DownTransition def
			end dup sendevent
			createevent copy dup /Action /UpTransition put
			sendevent
			}
    ] /new DefaultMenu send def

    /exitcleanly {
	% Destroy all windows that know /destroy
	{/destroy self send} AllWin
	% Wait 3 seconds for console to die
	0.05 sleep
	% Clear the screen
	framebuffer setcanvas
	1 setgray
	clippath fill
	% Terminate the server
	^C
    } def
    /exitnewsmenu [
	(No, not really.) {}
	(Yes, really!) { exitcleanly }
    ] /new DefaultMenu send def

    /rootmenu [
	(Applications =>)	applicationsmenu
	(Repair =>)		repairmenu
	(Exit NeWS =>)		exitnewsmenu
    ] /new DefaultMenu send def
} if
(NeWS/litewin.ps) LoadFile {
    % Demo menus loaded here because of window dependancies.
    (NeWS/demomenu.ps) LoadFile pop
} if

% Initialization
% Main is run by PS as soon as it has processed init.ps
% The default main starts up the root event mgr and starts
% an executive if debugging.  If you are using telnet to talk
% to your PS server, make sure to use the executive:
%	telnet localhost 144
%	..
%	executive
% Note that the default 144 can by changing NeWS_socket in your user.ps
/NeWS_socket 
    { (NEWSSOCKET) getenv } stopped
    { pop (%socketl144) } if
def

/DebuggingServer? false def % set true in your user.ps if you're debugging.
/go! {
    verbose? { (Starting root eventmgr\n) print } if
    /rooteventmgr [
	/rootmenu where { pop
	    MenuButton
	    { {newprocessgroup /showat rootmenu send} fork pop }
	    DownTransition framebuffer eventmgrinterest
	} if
	
	/Damaged {newprocessgroup damagepath clipcanvas PaintRoot newpath clipcanvas}
	null framebuffer eventmgrinterest
    ] forkeventmgr def
} def
/InteractionLock createmonitor def
/&main {go! DebuggingServer? {executive} if} def

/RemoteHostRegistry 100 dict def	% list of hosts allowed to connect to server.
RemoteHostRegistry localhostname true put
RemoteHostRegistry /localhost true put
/NetSecurityWanted true def		% false if everyone is allowed to connect

/&server_hook {} def

% The server; note that the dict size is client's userdict!
/server { { newprocessgroup
	    { NeWS_socket (r) file } stopped
	    { clear (%socketl2000) (r) file } if
	    dup getsocketlocaladdress (NEWSSERVER) exch putenv
	    (TERM) (PostScript) putenv
	    { dup mark exch acceptconnection
	      { 200 dict begin initmatrix newprocessgroup
		exch pop exch pop dup
		getsocketpeername /OriginatingHost exch def
&server_hook
                % See if OriginatingHost is in the Registry
                RemoteHostRegistry OriginatingHost known
                % localhostname returns the name of the machine as set by
                % hostname().  Problem is that getsocketpeername returns
                % on some machines a fully qualified hostname.  They DON'T
                % match.  An example is that zuni != zuni.dspo.gov.
                % Check for this case here.
                OriginatingHost localhostname anchorsearch
                { pop (.) anchorsearch
                    { pop pop RemoteHostRegistry localhostname known }
                    { pop false } ifelse }
                { pop false } ifelse or
                % Let through if no security wanted
                NetSecurityWanted not or

		 { cvx exec }
		 { currentcursorlocation
		   [ (Network security violation:)
		     (Rejected connection from ) OriginatingHost append ]
		   popmsg } ifelse
		currentprocess killprocessgroup} fork
	      cleartomark} loop} fork pop } def

% Your user.ps file allows you to over-ride all the standard defaults
% and to do your own initialization.
% Make sure to "protect" your defaults via the following:
%	/Foo where { pop
%	    Foo begin
%	        < changes to Foo's defaults here >
%	    end
%	} if
% To change the root menu, use insertitem.  Thus if you had your own
% menu you wanted to include, then use:
%	/mymenu [ 
%	    (Foo =>)		foomenu
%	    (Test!)		{(test) forkunix}
%	    (Color Wheel!)	{(colorwheel) forkunix}
%	] /new DefaultMenu send def
%	0 (My Menu =>) mymenu /insertitem rootmenu send

(user.ps) LoadFile pop

