% Oughta-be primitives!
%/autoload { [ 2 index /run cvx 3 index cvx ] cvx def pop } def
%/fileexists {{(r) file} stopped {pop pop false} {closefile true} ifelse} def
/rect {dup 0 exch rlineto exch 0 rlineto neg 0 exch rlineto closepath } ?def

%
% A case/switch statement.  Takes a key for the case and an array.
% Generally the array is executable to avoid evaluating the array
% each time case is called:
%	obj {
%	    key1	{proc1}
%	    key2 key3	{proc2}
%	    key4	{proc3}
%	    /Default	{proc4}
%	} case
%
/case {			%  v { k {} k k {} .... /Default {} }  CASE  -
    false exch {				% v bool k|{}
	exch {					% v k|{}
	    dup xcheck {exit} {pop true} ifelse	% v bool|{}
	} {
	    2 copy eq exch /Default eq or	% v bool
%	    2 copy eq exch			% v bool k
%	    dup /Default eq exch true eq or or	% v bool
	} ifelse
    } forall					% v bool|{}
    dup xcheck {exch pop exec} {pop pop} ifelse
} ?def

/append {	% obj1 obj2  =>  obj3 (concatinates arrays, strings, and dicts)
		% Dicts: second dict over-rides common keys
    1 index length 1 index length add	% obj1 obj2 totalsize
    1 index type dup /dicttype eq {
        pop dict begin
            exch {def}forall {def}forall
            currentdict
        end
    } {
        /arraytype eq {array} {string} ifelse	% a1 a2 A
	dup 4 -1 roll 1 index copy length	% a2 A A l1
	4 -1 roll putinterval
    } ifelse
} ?def

% Error handling:
% The list of errors NeWS emits:
/StandardErrorNames [
    /dictfull		/dictstackoverflow	/dictstackunderflow
    /execstackoverflow	/interrupt		/invalidaccess
    /invalidexit	/invalidfileaccess	/invalidfont
    /invalidrestore	/ioerror		/limitcheck
    /nocurrentpoint	/rangecheck		/stackoverflow
    /stackunderflow	/syntaxerror		/typecheck
    /undefined		/undefinedfilename	/undefinedresult
    /unimplemented	/unmatchedmark		/unregistered
    /VMerror
] def
% An errordict that simply stops on all errors.
/StopOnErrorsDict StandardErrorNames dup length dict begin
    { {pop stop} def } forall
    currentdict
    end
def
% A procedure acting like "stopped" even in the presence of an errordict.
/errored { % proc => bool (executes proc, returning true if error occurred)
10 dict begin
    /errordict StopOnErrorsDict def
    stopped
end
} def

% Defaults & Constants:
% Done here so xxx.ps can use them; also see below for defaults
/UserProfile 100 dict def

/DefaultFamily		/Times-Roman def
/DefaultPointSize	14 def
/DefaultFont		DefaultFamily findfont DefaultPointSize scalefont def

/textcolor		0 0 0 rgbcolor def
/backgroundcolor	1 1 1 rgbcolor def
/bordercolor		textcolor def

/LeftMouseButton	dup def
/MiddleMouseButton	dup def
/RightMouseButton	dup def
/MouseDragged		dup def
/DownTransition		dup def
/UpTransition		dup def

/PointButton		LeftMouseButton def
/AdjustButton		MiddleMouseButton def
/MenuButton		RightMouseButton def

systemdict /verbose? known not {/verbose? false def} if
/VMstr {
    10 dict begin vmstatus /break exch def /used exch def /avail exch def
	used  round (      ) cvs ( Used, )
	avail round (      ) cvs ( Avail, )
	break round (      ) cvs ( Break)
	5 {append} repeat
    end
} def
/LoadFile { % filename => bool (execute file, return false if problems)
    mark exch
    
    % get the file, leaving string & file-or-null on stack
    dup					% mark s s
    { (r) file } stopped {
        pop pop				% mark s [one pop for the (r)!]
        { (HOME) getenv } stopped {
            pop null			% mark s null
        } {				% mark s home
            (/) append exch append dup	% mark s s (= "home/s")
            { (r) file } stopped {pop pop null} if
        } ifelse
    } if				% mark s file-or-null

    % now got file (or null!); so execute the file.
    dup null eq {
        cleartomark false
    } {
	verbose? { 1 index print ( loading...\n) print } if
	{cvx exec} stopped {
	    counttomark 1 sub index print
            (: Load failed due to error in file.\n) print
            cleartomark false
	} {
            cleartomark true
	} ifelse
    } ifelse
} def
/popmsg { 	% cx cy strings =>
  { 10 dict begin newprocessgroup
    dup type /arraytype ne { 1 array astore } if
    /strs exch def
    /y exch def
    /x exch def
    /Times-Roman findfont 24 scalefont setfont
    0 setgray
    /width 0 def
    strs { stringwidth pop width max /width exch def } forall
    /height strs length 30 mul def
    /y y height 2 div add 25 sub def
    /x x width 2 div sub def
    /x0 x 10 sub def
    /y0 y 25 add def
    /x1 x0 width add 20 add def
    /y1 y0 height 5 add sub def
    x0 y0 10 sub moveto
    x0 y1 x1 y1 10 arcto
    x1 y1 x1 y0 10 arcto
    x1 y0 x0 y0 10 arcto
    x0 y0 x0 y1 10 arcto
    /cv framebuffer newcanvas def
    closepath
    cv reshapecanvas cv setcanvas
    cv /SaveBehind true put
    cv /Mapped true put
    clippath 0 setgray fill
	/x0 x0 2 add def /y0 y0 2 sub def
	/x1 x1 2 sub def /y1 y1 2 add def
    x0 y0 10 sub moveto
    x0 y1 x1 y1 10 arcto
    x1 y1 x1 y0 10 arcto
    x1 y0 x0 y0 10 arcto
    x0 y0 x0 y1 10 arcto clear
    1 setgray fill
    ColorDisplay? { 1 .5 .5 sethsbcolor } { 0 setgray } ifelse
    strs { x y moveto show /y y 30 sub def } forall
    damagepath newpath
    createevent begin
	/Canvas currentcanvas def
	/Name 4 dict begin /Damaged true def
		/ExitEvent true def
		/LeftMouseButton true def currentdict end def
	currentdict
    end expressinterest
    awaitevent
    cv /Mapped false put
  } fork pause
  4 1 roll pop pop pop
} def

/InitPaintRoot {
    PaintRoot
    /ROOTPROC
	clippath pathbbox .666 mul exch .5 mul exch 4 2 roll pop pop
	[ (Welcome to NeWS Version ) version append
	  (Please wait for loading to finish) ]
	popmsg def
} def

UserProfile /UIModule /liteUI put
0 setlinewidth
