%
%		@(#)init.ps 9.10 88/02/10
%
%  This file is read by the postscript server when it starts.
%  It performes several tasks:
%  	* Defines several unimmplemented primitives.
%  	* Defines several almost-primitives.
%	* It performs standard initialization:
%		- Framebuffer & keyboard/mouse
%		- Starts server
%	* Defines several "standard" defaults & constants
%	* Loads the rest of the .ps files
%	* Defines the user's rootmenu
%	* Defines the user's defaults
%

% Setup framebuffer.  Needs to be here to avoid an obscure input bug.
%(Initializing framebuffer & keyboard/mouse.\n) print
{ (FRAMEBUFFER) getenv } stopped { clear (/dev/fb) } if
/framebuffer exch createdevice def
framebuffer dup setcanvas
startkeyboardandmouse
/?def { systemdict 2 index known { pop pop } { def } ifelse } def
/Color get /ColorDisplay? exch def
500 FontDirectory extend pop
FontDirectory begin
	clear enumeratefontdicts count
	{ mark exch { findfilefont dup /FontName get exch def }
	  stopped cleartomark } repeat
end
/Times-Roman findfont 12 scalefont setfont
/DefaultRootGrayOrColor ColorDisplay? {.55 .5 .7 hsbcolor} {.88} ifelse def
/PaintRoot {
    gsave
%    framebuffer dup setcanvas
%    /Color get {.55 .5 .7 sethsbcolor} {.88 setgray} ifelse
    framebuffer setcanvas
    DefaultRootGrayOrColor dup type /colortype eq {setcolor} {setgray} ifelse
    clippath fill
    grestore
} def

% Define unimmplemented primitives
/run { (r) file cvx exec } ?def
/[ systemdict /mark get ?def
/] { counttomark array astore exch pop } ?def
/image { buildimage imagecanvas } ?def
/imagemask { 1 3 1 roll 4 -1 roll
    { buildimage true exch imagemaskcanvas } 
    { buildimage false exch imagemaskcanvas } ifelse } ?def
/pathforall { { 0 0 0 0 } astore pathforallvec } ?def

% Note: dictstack currently must use def rather than ?def because the
% following is in primitives.h:
% 	{ 51, "dictstack",                1,  0, 0},
%#define	       dictstack_primitive 51
/dictstack { % array => subarray
    currentprocess /DictionaryStack get exch copy
} def %?def
/execstack { % array => subarray
    currentprocess /ExecutionStack get		% a a'
    % Now get every other element & skip last entry; it's this proc itself!
    [ exch 0 2 2 index length 4 sub {		% a [ .. a' i
        1 index exch get exch			% a [ a0 .. ai a'
    } for pop ]					% a a''
    exch copy
} ?def

%/FontDirectory { 
%    40 dict begin
%    mark enumeratefontdicts counttomark
%    { /MagicFont def } repeat pop
%    currentdict
%    systemdict /FontDirectory currentdict put
%    end } def
/bind {
    dup length 0 1 3 2 roll 1 sub {
	2 copy get
	dup type /arraytype eq {
	    bind pop pop
	} {
	    dup where {
		exch get
		dup type /operatortype eq {
		    2 index 2 index
		    3 2 roll put
		    pop
		} {
		    pop pop 
		} ifelse
	    } { 
		pop pop
	    } ifelse
	} ifelse
    } for
} ?def
/ExecutiveErrorHandler {
    (***ERROR*** \n) print
    $error /message known { $error /message get null ne } { false } ifelse
	 { $error /message get print (*****\n) print}
	 { $error { exch (\t%:\t%\n)  printf } forall stack }
    ifelse
} def
/console (/dev/console) (w) file def
/executive { % - => - (Execute the current file)
    countdictstack 1 eq {200 dict begin} if % make sure there is a user dict!
    (Welcome to NeWS Version ) print version print (\n) print
    currentprocess /ErrorDetailLevel 1 put
    /bye { quit } def
    /execfile currentfile dup null eq {pop (%stdin) (r) file} if def
    {
        { execfile status not { quit } if
          { execfile cvx exec } stopped pop
	  execfile status not { quit } if
	  ExecutiveErrorHandler } loop
    } stopped { quit } if
} def
