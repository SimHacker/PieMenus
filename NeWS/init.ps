% Add $NEWSHOME/bin to the path if it isn't already there
mark
{ (PATH) getenv dup (NEWSHOME) getenv (/bin) append search not
    { pop dup (.:) anchorsearch { pop pop dup length 1 sub 1 exch getinterval } { pop } ifelse
      dup (:) anchorsearch { pop pop } { pop pop (:) exch append } ifelse
      (:) (NEWSHOME) getenv append (/bin) append exch append
      (PATH) exch putenv } if
} stopped cleartomark


% standard xxx.ps files & user's private initialization code
(NeWS/statdict.ps) LoadFile pop
(NeWS/colors.ps) LoadFile pop
(NeWS/cursor.ps) LoadFile {
    /setstandardcursor { % /shape /mask canvas => - (set cursor from font)
	gsave
	setcanvas			% /shape /mask
	cursordict begin
	    cursorfont 3 1 roll		% cursorfont /shape /mask
	    load exch load exch		% cursorfont shape mask
	end
	setcanvascursor
	grestore
    } def
    
    % Set root window cursor
    /hourg /hourg_m framebuffer setstandardcursor
} if
