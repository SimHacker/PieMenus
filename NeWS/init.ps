	exch
	//&kshp exch 0 exch put
	-1 exch
	 {   //&kshc 0 2 index put
	     1 index 0 ge //&kshp { pop pop } ifelse
	     //&kshc show
	     //&kshc 0 get
	 } forall
	 pop
} def
/rand { random 2147483648 mul } ?def
/showpage {  } ?def
/stack {
  count dup 0 eq {
    (Empty stack\n) print pop
  } {
    0 exch 1 exch 1 sub { index = } for
  } ifelse
} def
