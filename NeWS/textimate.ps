%!

systemdict /ic known not {
  systemdict begin
    /ic (%/smi/founders.im8) [(NEWSHOME) getenv] sprintf readcanvas def
  end
} if

  /finger-path { % - => -
      newpath
      .2 0 moveto
      0 .3 lineto
      .1 .5 lineto
      .2 .5 lineto
      .2 .55 lineto
      .3 .6 .9 controlpoint
%      .3 .6 lineto
      .4 .55 lineto
      .4 .95 lineto
      .5 1 .9 controlpoint
%      .5 1 lineto
      .6 .95 lineto
      .6 .55 lineto
      .7 .6 .8 controlpoint
%      .7 .6 lineto
      .8 .55 lineto
      .8 .5 lineto
      .9 .55 .9 controlpoint
%      .9 .55 lineto
      1 .5 lineto
      1 .3 lineto
      .8 0 lineto
      closepath
  } def

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

/MyCamWindow CamWindow
dictbegin
dictend
classbegin
  /stack-canvas { % parent source => -
    /SourceCan exch def
    /ParentCan exch def
    /NewCan ParentCan newcanvas def
    /Canvases [ NewCan Canvases aload pop ] def
    NewCan /Transparent false put
    NewCan /Retained true put
    ParentCan setcanvas
    clippath NewCan reshapecanvas
    NewCan setcanvas
    clippath pathbbox scale pop pop
    .5 .5 translate rot neg rotate -.5 -.5 translate
    10 { pause } repeat
    SourceCan imagecanvas
    10 { pause } repeat
    gsave
      /Courier findfont 12 scalefont setfont
      initmatrix
      5 5 translate
      rot (xxxxx) cvs
      -1 1 index stringbbox insetrect rectpath
      gsave 1 setgray fill grestore
      0 setgray stroke
      0 0 moveto
      0 setgray show
    grestore
    /SourceCan null def % some day it might refresh from these on resize...
    [Canvases length 1 sub 1 max  0  1  8  1 Canvases length div]
    {updaterange} VScrollbar send
    0 reveal-canvas
    NewCan /Mapped true put
    10 { pause } repeat
  } def
classend def

    /Win framebuffer /new MyCamWindow send def
    /reshapefromuser Win send
    /map Win send
    /MyCan Win /ClientCanvas get def
    MyCan /Transparent false put

1 3 90 { /i exch def
  gsave
    /c framebuffer newcanvas def

    framebuffer setcanvas
    newpath
    0 0
    i 17 mul cos  i 4 mul sin  mul  1 add 50 mul 30 add
    i 9 mul sin  i 30 mul cos  mul  1 add 50 mul 30 add
    rectpath
    c reshapecanvas

    c setcanvas
    c mapcanvas
    c canvastotop
    erasepage

    clippath pathbbox
    scale pop pop

    gsave
      .5 .5 translate
      /rot i 2 mul def
      rot rotate
      .8 .8 scale
      -.5 -.5 translate
      finger-path
      gsave
        %clip
	0 setgray
	%false ic imagemaskcanvas
%        .5 setgray fill
	.2 .16 moveto
	.035 .035 scale (f)show(o)show(o)show
      grestore
      0 setgray
      .05 setlinewidth
      stroke
    grestore
  grestore

  MyCan c /stack-canvas Win send
  .15 60 div sleep

  /c null def
} for

