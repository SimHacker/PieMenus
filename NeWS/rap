% ClassBufferCanvas
%
% This canvas is used as an off screen buffer. (But it is sometimes
% mapped on screen in a popup window frame for instructional purposes.)
%
/ClassBufferCanvas ClassCanvas []
classbegin

    /Transparent false def
    /Retained true def
    /Mapped false def

    /Paint nullproc def

    /minsize { % - => w h
        /size self send
    } def

classend def

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% ClassPictCanvas
%
% This canvas holds a scaled copy of the source picture.
%
/ClassPictCanvas ClassBufferCanvas [/Picture]
classbegin

    /setpicture { % image => -
	/Picture exch store
	Picture self CopyCanvas
    } def

    % Since the canvas is retained, this only gets called when there
    % is damage, e.g. when the canvas is reshaped.  Reset the picture,
    % causing it to rescale to the current canvas size.
    %
    /Paint { % - => -
	Picture self CopyCanvas
    } def

classend def

