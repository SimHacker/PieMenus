#
# MDW Printcap, as used on yetch
#
# PostScript printer driven by TranScript software
lp|yetch|lw|ps|psyetch|postscript|PostScript:\
	:lp=/dev/ttyb:rp=lw:sd=/usr/spool/lw:sh:if=/usr/local/lib/lw/psif:\
	:of=/usr/local/lib/lw/psof:lf=/usr/spool/lw/log:\
	:br#9600:rw:fc#0000374:fs#0000003:xc#0:xs#0040040:mx#0:\
        :gf=/usr/local/lib/lw/psgf:\
        :tf=/usr/local/lib/lw/pstf:\
        :nf=/usr/local/lib/lw/psnf:\
        :vf=/usr/local/lib/lw/psvf:\
	:af=/usr/spool/lw/lw-use:
hattalp|hattalw|hattaps|lphatta|pshatta|postscripthatta|PostScriptHatta:\
	:lp=:rm=hatta.cs.umd.edu:\
	:rp=lw:\
	:sd=/usr/spool/hattalw:\
	:lf=/usr/spool/hattalw/log:
